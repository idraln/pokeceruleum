raw `
SapphireCity_ShopElevator_MapScripts::
	.byte 0
`

script SapphireCity_ShopElevator_Employee {
    lock
	faceplayer
	setvar(VAR_0x8004, 0)
	call_if_unset(FLAG_TEMP_2, SapphireCity_ShopElevator_SetFloor)
	copyvar(VAR_0x8005, VAR_DEPT_STORE_FLOOR)
	//special(ShowDeptStoreElevatorFloorSelect)
	msgbox(format("Hey! Which floor do you want to go to?"))
	waitmessage
	setvar(VAR_0x8004, 0)
	specialvar(VAR_RESULT, GetDeptStoreDefaultFloorChoice)
	switch(var(VAR_RESULT)) {
        case 0: call(SapphireCity_ShopElevator_ChooseFloorFrom3rd)
        case 1: call(SapphireCity_ShopElevator_ChooseFloorFrom2nd)
        case 2: call(SapphireCity_ShopElevator_ChooseFloorFrom1st)
    }
	end
}

script SapphireCity_ShopElevator_ChooseFloorFrom3rd {
    multichoicedefault(0, 0, MULTI_FLOORS, 0, FALSE)
    goto(SapphireCity_ShopElevator_ChooseFloor)
    end
}

script SapphireCity_ShopElevator_ChooseFloorFrom2nd {
    multichoicedefault(0, 0, MULTI_FLOORS, 1, FALSE)
    goto(SapphireCity_ShopElevator_ChooseFloor)
    end
}

script SapphireCity_ShopElevator_ChooseFloorFrom1st {
    multichoicedefault(0, 0, MULTI_FLOORS, 2, FALSE)
    goto(SapphireCity_ShopElevator_ChooseFloor)
    end
}

script SapphireCity_ShopElevator_ChooseFloor {
    switch(var(VAR_RESULT)) {
        case 0: call(SapphireCity_ShopElevator_3rdFloor)
        case 1: call(SapphireCity_ShopElevator_2ndFloor)
        case 2: call(SapphireCity_ShopElevator_1stFloor)
        case 3: call(SapphireCity_ShopElevator_ExitFloorSelect)
        case MULTI_B_PRESSED: call(SapphireCity_ShopElevator_ExitFloorSelect)
    }
}

script SapphireCity_ShopElevator_1stFloor {
    setvar(VAR_0x8006, DEPT_STORE_FLOORNUM_1F)
	setdynamicwarp(MAP_SAPPHIRE_CITY_SHOP1F, 3, 4)
	goto_if_eq(VAR_DEPT_STORE_FLOOR, DEPT_STORE_FLOORNUM_1F, SapphireCity_ShopElevator_ExitFloorSelect)
	call(SapphireCity_ShopElevator_MoveElevator)
	setvar(VAR_DEPT_STORE_FLOOR, DEPT_STORE_FLOORNUM_1F)
	goto(SapphireCity_ShopElevator_ExitFloorSelect)
	end
}

script SapphireCity_ShopElevator_2ndFloor {
    setvar(VAR_0x8006, DEPT_STORE_FLOORNUM_2F)
	setdynamicwarp(MAP_SAPPHIRE_CITY_SHOP2F, 3, 4)
	goto_if_eq(VAR_DEPT_STORE_FLOOR, DEPT_STORE_FLOORNUM_2F, SapphireCity_ShopElevator_ExitFloorSelect)
	call(SapphireCity_ShopElevator_MoveElevator)
	setvar(VAR_DEPT_STORE_FLOOR, DEPT_STORE_FLOORNUM_2F)
	goto(SapphireCity_ShopElevator_ExitFloorSelect)
	end
}

script SapphireCity_ShopElevator_3rdFloor {
    setvar(VAR_0x8006, DEPT_STORE_FLOORNUM_3F)
	setdynamicwarp(MAP_SAPPHIRE_CITY_SHOP3F, 3, 1)
	goto_if_eq(VAR_DEPT_STORE_FLOOR, DEPT_STORE_FLOORNUM_3F, SapphireCity_ShopElevator_ExitFloorSelect)
	call(SapphireCity_ShopElevator_MoveElevator)
	setvar(VAR_DEPT_STORE_FLOOR, DEPT_STORE_FLOORNUM_3F)
	goto(SapphireCity_ShopElevator_ExitFloorSelect)
	end
}

script SapphireCity_ShopElevator_ExitFloorSelect {
    special(CloseDeptStoreElevatorWindow)
	release
	end
}
	
script SapphireCity_ShopElevator_MoveElevator {
    special(CloseDeptStoreElevatorWindow)
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	waitse
	special(MoveElevator)
	waitstate
	setflag(FLAG_TEMP_2)
	return
}
	
script SapphireCity_ShopElevator_SetFloor {
    special(SetDeptStoreFloor)
	return
}