raw `
CapeEast_House_MapScripts::
	.byte 0

`
script CapeEast_Sam_Intro_Right {
    lock
    if(var(VAR_WAKINGUP) == 0) {
        fwdtime(10, 00)
        playse(SE_PIN)
        applymovement(1, SamSurprised)
        waitmovement(0)
        delay(40)
        msgbox(format("Finally, you're awake!"))
        closemessage
        applymovement(1, SamToBed)
        waitmovement(0)
        delay(20)
        msgbox(format("You passed out as soon as you got on the boat. What's your name? And what were you doing alone in the deep seas? Were you on some kind of adventure? It's not usual to go there alone, you could've been really hurt."))
        msgbox(format("..."))
        msgbox(format("Huh? What's that? You were going to battle the President of Thura? Weird... I don't see any Pokéballs on your belt."))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, PlayerSurprised)
        waitmovement(0)
        playse(SE_PIN)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
        waitmovement(0)
        delay(20)
        msgbox(format("Oh snap! You lost all your Pokémons while you were stranded at sea? That's a bummer. Is that all you lost?"))
        msgbox(format("..."))
        msgbox(format("You lost your ID aswell? Well, in that case, you might have to go to the Town Hall to sort this out. Here, follow me. Let me show you the way."))
        closemessage
        applymovement(1, SamOutside)
        waitmovement(0)
        hideobjectat(1, MAP_CAPE_EAST_HOUSE)
        playse(SE_EXIT)
         
        applymovement(1, SamDisappear)
        waitmovement(0)
        setvar(VAR_WAKINGUP, 1)
        setflag(FLAG_HIDE_MAP_NAME_POPUP)
        setflag(FLAG_STARTER)
        release
        end
    }
    else {
        release
        end
    }
}

