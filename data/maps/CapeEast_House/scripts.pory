        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, PlayerOutOfBedLeft)
        applymovement(1, SamToBed)
        waitmovement(0)
        delay(50)
        msgbox(format("You passed out as soon as you got on the boat. What's your name? And what were you doing alone in the deep seas? Were you on some kind of adventure? It's not usual to go there alone, you could've been really hurt."))
        msgbox(format("..."))
