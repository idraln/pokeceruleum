raw `
SapphireCity_Shop3F_TM_MapScripts::
	.byte 0
`

script SapphireCity_Shop3F_TM_Clerk_1 {
    lock
    faceplayer
    if(var(VAR_SHOP_UPDATE) > 3) {
        msgbox(format("Hello, and welcome to the TM Department! How can I help you today?"))
        waitmessage
        pokemart(MartTMPassive)
        msgbox(format("Thank you for shopping with us! We'll hope to see you very soon!"))
    }
    else {
        msgbox(format("Hello there! Unfortunately, our department is still under construction. Come back later!"))
    }
    release
    end
}

mart MartTMPassive {
    ITEM_TM06
    ITEM_TM16
    ITEM_TM28
    ITEM_TM34
    ITEM_TM14
    ITEM_TM32
    ITEM_TM46
}

