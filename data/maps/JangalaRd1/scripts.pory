script JangalaRd1_Weirdo {
    lock
    faceplayer
    msgbox(format("Hehehe! I'm doing it! I'm finally going to live like a hermit, far away from civilization! I just need to get through these trees!"))
    turnobject(15, DIR_NORTH)
    release
    end
}

script JangalaRd1_Item1 {
    lock
    removeobject(19)
    giveitem(ITEM_BIG_ROOT)
    setflag(FLAG_ITEM_JANGALA_1)
    release
    end
}

script JangalaRd1_Item2 {
    lock
    removeobject(20)
    giveitem(ITEM_TM18)
    setflag(FLAG_ITEM_JANGALA_2)
    release
    end
}

script JangalaRd1_Item3 {
    lock
    removeobject(21)
