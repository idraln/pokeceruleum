raw `
JangalaRd1_MapScripts::
    map_script MAP_SCRIPT_ON_LOAD, JangalaRd1_OnLoad
	.byte 0
`

script JangalaRd_Triathlon {
    setvar(VAR_TRIATHLON, 3)
    end
}

script JangalaRd1_OnLoad {
    if(var(VAR_QUEST_HERMIT) > 3) {
        setmetatile(8, 87, METATILE_Bammobo_BushEntrance, TRUE)
        setmetatile(8, 88, METATILE_Bammobo_BushWarp, FALSE)
        special(DrawWholeMapView)
        end
    }
    else {
        end
    }
}

script JangalaRd1_Marie {
    trainerbattle_single(TRAINER_JANGALA_1, Marie1, Marie2)
    msgbox(format("I'm a big fan of Komala, but I haven't encountered it yet. Soon!"))
    closemessage
    end
}

text Marie1 {
    format("No, don't go! I need to find Komala first!")
}

text Marie2 {
    format("Oh... I guess you'll catch it before me...")
}

