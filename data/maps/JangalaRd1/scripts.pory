script JangalaRd1_Camper1 {
    lock
    faceplayer
    msgbox(format("This is it! The perfect spot to bivouac! I called dibs, you can't settle here. Sorry bud, I don't make the rules!"))
    release
    end
}

script JangalaRd1_WorkerF {
    lock
    faceplayer
    msgbox(format("Hiya! Would you like to try our newly made zip line? It's totally free of charge!"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        msgbox(format("Great! Hop in!"))
        closemessage
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        if(var(VAR_TEMP_1) == 37) {
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down walk_left * 2 face_down))
            waitmovement(0)
        }
        else {
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left face_down))
            waitmovement(0)
        }
        turnobject(8, DIR_SOUTH)
        msgbox(format("Ready? Now push with your legs!"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(slide_down * 15 face_right))
        waitmovement(0)
        applymovement(9, moves(walk_up face_left))
        waitmovement(0)
        msgbox(format("So? Nice sensations, eh? Don't hesitate to try it again!"))
        closemessage
        applymovement(9, moves(walk_down face_up))
        waitmovement(0)
    }
    else {
        msgbox(format("Haha, no worries! I get that I can be a bit frightening. If you need to go down, you can still paddle through the river!"))
    }
    release
    end
}

script JangalaRd1_WorkerM {
    lock
    faceplayer
    msgbox(format("Our zip line rules. The next step is to build one that is even longer on Passaqua Way!"))
    release
    end
}

script JangalaRd1_Camper2 {
    lock
    faceplayer
    msgbox(format("Thank Arceus for that refuge! I'm exhausted. How is she still full of energy? Why didn't we go to the movies for a first date?"))
    release
    end
}

