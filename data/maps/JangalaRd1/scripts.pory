script JangalaRd1_Hermit {
    lock
    faceplayer
    gettimeofday
    if(var(VAR_0x8000) == 3) {
        namebox("Hermit")
        msgbox(format("There you are. Get back, I'm gonna cut that bush."))
        closemessage
        hidenamebox
        applymovement(23, moves(face_up))
        waitmovement(0)
        delay(20)
        playse(SE_M_CUT)
        delay(20)
        setmetatile(8, 87, METATILE_Bammobo_BushEntrance, TRUE)
        setmetatile(8, 88, METATILE_Bammobo_BushWarp, FALSE)
        special(DrawWholeMapView)
        delay(20)
        applymovement(23, moves(face_player))
        waitmovement(0)
        namebox("Hermit")
        msgbox(format("In we go."))
        closemessage
        hidenamebox
        delay(20)
        applymovement(23, moves(face_up))
        waitmovement(0)
        delay(10)
        removeobject(23)
        setflag(FLAG_HERMIT_JANGALA)
        clearflag(FLAG_HERMIT_JANGALA_BUSH)
        setvar(VAR_QUEST_HERMIT, 4)
        playse(SE_EXIT)
        release
        end
    }
    else {
        namebox("Hermit")
        msgbox(format("We can't go in yet. Come back when it's nighttime."))
        closemessage
        hidenamebox
        release
        end
    }
}

