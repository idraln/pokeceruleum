script JangalaRd1_Chris {
    trainerbattle_single(TRAINER_JANGALA_11, Chris1, Chris2)
    if(var(VAR_DISAPPEARANCE) == 3) {
        msgbox(format("Haha, I knew I had to persevere! Look at what I caught just now!"))
    }
    else {
        msgbox(format("This is pissing me off. What did we do to deserve that? What are we supposed to do, harvest berries for a living? No way!"))
    }
    closemessage
