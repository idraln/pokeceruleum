raw `
BleakRift_MapScripts::
	.byte 0
`

script BleakRift_EscapeRope {
    lock
    removeobject(6)
    setflag(FLAG_BLEAK_ITEM_1)
    giveitem(ITEM_ESCAPE_ROPE)
    release
    end
}

