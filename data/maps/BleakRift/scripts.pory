script BleakRift_Kyogre {
    lock
    applymovement(1, moves(emote_exclamation_mark))
    waitmovement(0)
    faceplayer
    playse(SE_PIN)
    delay(40)
    setwildbattle(SPECIES_KYOGRE, 75, ITEM_BLUE_ORB)
    waitse
    playmoncry(SPECIES_KYOGRE, CRY_MODE_ENCOUNTER)
    waitmoncry
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
	waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    delay(20)
    fadescreen(FADE_TO_BLACK)
    delay(40)
    removeobject(1)
    setflag(FLAG_KYOGRE_BLEAK)
    fadescreen(FADE_FROM_BLACK)
    setvar(VAR_DISAPPEARANCE, 2)
    release
    end
}

script BleakRift_Sign {
    lockall
    msgbox(format("A..ah! I l.st m. es.ap. ro.e! I'm s.uck h.re! T. wh.ever re.d. t.is, te.l .y fa.ily I l.ve t.em! M.y Arc.us h..e mer.y o. m. so.l!"))
    releaseall
    end
}