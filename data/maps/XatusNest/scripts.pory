raw `
XatusNest_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, XatusNest_OnFrame
	.byte 0

XatusNest_OnFrame:
    map_script_2 VAR_SIDE_STORY_RETRO, 3, XatusNest_Arrival
    .2byte 0
`

script XatusNest_Arrival {
    lock
    setrespawn(HEAL_LOCATION_ARRAY)
    msgbox(format("Alright, you proved to us that you are in fact from here. Sorry for what happened to you, though. Seems like your old village is in ruins now. Mission, over! Back to the tent for me."))
    closemessage
    applymovement(1, moves(walk_up * 2))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left face_right))
    waitmovement(0)
    removeobject(1)
    playse(SE_EXIT)
    setflag(FLAG_ARMY_HERRON)
    setflag(FLAG_DAVE_GLORRAY)
    setflag(FLAG_KAM_VIRIMANTE)
    completequest(QUEST_HOME)
    setflag(FLAG_HOME_QUEST_COMPLETE)
    setvar(VAR_SIDE_STORY_RETRO, 4)
    setvar(VAR_SHOP_UPDATE, 5)
    if(var(VAR_DIFFICULTY_LEVEL) == 0) {
        setvar(VAR_LEVELS, 55)
    }
    else {
        setvar(VAR_LEVELS, 100)
    }
    delay(20)
    pokenavcall(XatusNest_Shop_Text)
    waitmessage
    setvar(VAR_SHOP_UPDATE, 6)
    release
    end
}

script XatusNest_ShopUpdate {
    lockall
    faceplayer
    pokenavcall(XatusNest_Shop_Text)
    waitmessage
    setvar(VAR_SHOP_UPDATE, 6)
    releaseall
    end
}

script XatusNest_TM {
    lock
    removeobject(2)
    setflag(FLAG_ITEM_NEST)
    giveitem(ITEM_TM38)
    release
    end
}

text XatusNest_Shop_Text {
    "You just received a new\n"
    "text message from:\l"
    "Thura's Mart Association\l"
    "'Hello, dear customer!\l"
    "We'd like to inform you\l"
    "that our range of products\l"
    "is finally complete! You can\l"
    "now buy items such as Full\l"
    "Restores, Revives, and much\l"
    "more!\l"
    "Come by and see by yourself!'"
}

script XatusNest_Egg {
    lock
    faceplayer
    msgbox(format("This looks like an Egg. Take it?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        giveegg(SPECIES_NATU)
        removeobject(3)
        setflag(FLAG_NATU_EGG_LEAGUE)
        playse(MUS_LEVEL_UP)
        msgbox(format("You just received an Egg."))
    }
    else {
        msgbox(format("Decided against it."))
    }
    release
    end
}