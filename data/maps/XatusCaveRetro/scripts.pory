raw `
XatusCaveRetro_MapScripts::
	.byte 0
`

script XatusCaveRetro_Reveal {
    lock
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    if(var(VAR_TEMP_0) == 7) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 2 walk_right * 2 walk_up))
        waitmovement
    }
    elif(var(VAR_TEMP_0) == 8) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 2 walk_right walk_up))
        waitmovement
    }
    elif(var(VAR_TEMP_0) == 9) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 3))
        waitmovement
    }
    delay(40)
    turnobject(1, DIR_WEST)
    namebox("Guard")
    msgbox(format("Aisha... I don't understand! After Ulrich left, the painting was completely destroyed... I hurried to let you know what happened, but when I came back..."))
    closemessage
    hidenamebox
    turnobject(1, DIR_NORTH)
    delay(20)
    namebox("Guard")
    msgbox(format("...The painting was back to its original state. As pristine as if it was just drawn."))
    closemessage
    hidenamebox
    delay(20)
    turnobject(2, DIR_EAST)
    delay(20)
    namebox("Grandma")
    msgbox(format("Now, you fully understand why I wanted you to keep the cave from everyone else. There is truly something mystical about this place, something that we will never grasp... And we must protect it."))
    closemessage
    hidenamebox
    delay(20)
    turnobject(2, DIR_NORTH)
    delay(20)
    namebox("Grandma")
    msgbox(format("...But for now, I must return to my duties."))
    closemessage
    hidenamebox
    delay(20)
    applymovement(2, moves(walk_down walk_right * 2 face_up))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    namebox("Grandma")
    msgbox(format("{PLAYER}, you go and live your adventure, you fully deserve so. You will bring great pride to our family."))
    closemessage
    hidenamebox
    delay(20)
    applymovement(2, moves(walk_down))
    waitmovement(0)
    delay(20)
    namebox("Grandma")
    msgbox(format("As for your brother, don't worry about him. He'll behave. He always does... sort of."))
    closemessage
    hidenamebox
    delay(20)
    applymovement(2, moves(walk_down * 5))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement(0)
    delay(40)
    fadescreenspeed(FADE_TO_BLACK, 4)
    delay(40)
    clearflag(FLAG_RETRO_INIT)
    msgbox(format("Lad! Wake up! You're free to go!"))
    special(RestorePlayerState)
    setflag(FLAG_DEXNAV_GET)
    setflag(FLAG_DAVE_GLORRAY)
    setflag(FLAG_SYS_OPTIONS_DISABLE)
    setflag(FLAG_SYS_DISABLE_SAVE)
    setflag(FLAG_SYS_PHONE_GET)
    warpsilent(MAP_XATUS_NEST, 23, 50)
    release
    end
}