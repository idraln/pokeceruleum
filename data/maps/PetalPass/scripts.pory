text Theo1 {
    format("Haha! Get ready to taste my newly acquired skills!")
}

text Theo2 {
    format("Well, I still have to practice my moves.")
}

text Clara1 {
    format("I just got accepted into Cruzeira's Botanic School! You'll be a perfect first subject of study!")
}

text Clara2 {
    format("Ah, very interesting! How did you do that?")
}

movement PP_CantPass {
    walk_up
}