raw `
Frux_House1_MapScripts::
	.byte 0
`

script Frux_House1_Worker {
    lock
    faceplayer
    msgbox(format("I've got my hands on loads of hidden treasures in the Ironair. Wanna take a look?"))
    waitmessage
    pokemart(FruxHouse1)
    msgbox(format("Come back when you need something else."))
    release
    end
}

mart FruxHouse1 {
    ITEM_AUSPICIOUS_ARMOR
    ITEM_MALICIOUS_ARMOR
    ITEM_MOON_STONE
    ITEM_SUN_STONE
}