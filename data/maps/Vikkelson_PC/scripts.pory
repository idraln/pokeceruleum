raw `
Vikkelson_PC_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Vikkelson_PC_OnTransition
    .byte 0
`

script Vikkelson_PC_OnTransition {
    setrespawn(HEAL_LOCATION_VIKKELSON)
    end
}


script Vikkelson_PC_Nurse {
    lock
	faceplayer
	setvar(VAR_0x8004, 0)
	msgbox(format("Hey there, welcome to Vikkelson's Pokémon Center! How's it going? Would you like to heal your party?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
        incrementgamestat(GAME_STAT_USED_POKECENTER)
        msgbox(format("Okay, let me take your Pokémons."))
        hidefollower(0)
        applymovement(1, PkmnCenter_NurseTurn)
        waitmovement(0)
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
        waitfieldeffect(FLDEFF_POKECENTER_HEAL)
        applymovement(1, PkmnCenter_NurseReTurn)
        waitmovement(0)
        special(HealPlayerParty)
        msgbox(format("Here you go, your Pokémons are fully healed!"))
        waitmessage
        applymovement(1, PkmnCenter_NurseBow)
        waitmovement(0)
        msgbox(format("We hope to see you soon!"))
        release
        end
    }
    else {
        msgbox(format("No worries! Come back soon!"))
        release
        end
    }
}

script Vikkelson_PC_Man {
    lock
    faceplayer
    msgbox(format("Step back, I think I'm gonna be sick... I know this place only heals Pokémons, but what about my drunk ass?"))
    turnobject(2, DIR_WEST)
    release
    end
}

script Vikkelson_PC_Woman {
    lock
    faceplayer
    msgbox(format("There's only one place that's missing in Vikkelson: Pokémon fights. What if I want to train my beautiful Azumarill AND have great fun, both at the same time?"))
    release
    end
}