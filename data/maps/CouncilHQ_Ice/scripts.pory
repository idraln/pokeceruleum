raw `
CouncilHQ_Ice_MapScripts::
	.byte 0
`

script CouncilHQ_Ice_Battle {
    lock
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    if(var(VAR_TEMP_1) == 3) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 2 walk_down * 2 face_left))
        waitmovement(0)
    }
    elif(var(VAR_TEMP_1) == 4) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 2 walk_down face_left))
        waitmovement(0)
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    namebox("Colleen")
    msgbox(format("{PLAYER}! Thank you again for what you've done for Thura. But I have a role to fulfill... Let's do it!"))
    closemessage
    hidenamebox
    delay(20)
    setflag(FLAG_TRAINERBATTLE)
    if(var(VAR_MAIN_STORY) < 56) {
        trainerbattle_no_intro(TRAINER_COUNCIL_ICE, Colleen2)
    }
    else {
        trainerbattle_no_intro(TRAINER_COUNCIL_ICE_2, Colleen2)
    }
    if (var(VAR_TRAINERBATTLE) == B_OUTCOME_LOST) {
        namebox("Colleen")
        msgbox(format("Watch out! You're gonna catch a cold!"))
        closemessage
        hidenamebox
        special(HealPlayerParty)
        setvar(VAR_COUNCIL_TRIES, 1)
        setvar(VAR_COUNCIL_FIGHT, 0)
        setvar(VAR_COUNCIL_ICE, 0)
        setvar(VAR_COUNCIL_FIRE, 0)
        setvar(VAR_COUNCIL_ROCK, 0)
        clearflag(FLAG_COUNCIL_ICE)
        clearflag(FLAG_COUNCIL_ROCK)
        clearflag(FLAG_COUNCIL_FIRE)
        clearflag(FLAG_COUNCIL_FIGHT)
        warpsilent(MAP_COUNCIL_HQ_LOBBY, 3, 11)
        releaseall
        end
    }
    else {
        namebox("Colleen")
        msgbox(format("I need to tweak the AC and crank it a bit more..."))
        hidenamebox
        setvar(VAR_COUNCIL_ICE, 1)
        setflag(FLAG_COUNCIL_ICE)
        releaseall
        end
    }
}

script CouncilHQ_Ice_Colleen {
    lock
    faceplayer
    namebox("Colleen")
    msgbox(format("Now, where is that remote? What a dumb idea it was to put the AC all the way up here..."))
    hidenamebox
    release
    end
}

text Colleen2 {
    format("Really? The cold didn't affect you?")
}