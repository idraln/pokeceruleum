raw `
PkmnLeagueHQ_Lobby_MapScripts::
    map_script MAP_SCRIPT_ON_TRANSITION, PkmnLeagueHQ_Lobby_OnTransition
    .byte 0
`

script PkmnLeagueHQ_Lobby_OnTransition {
    setrespawn(HEAL_LOCATION_PKMN_LEAGUE_HQ)
    end
}

script PkmnLeagueHQ_Lobby_Nurse {
    lock
    faceplayer
    setvar(VAR_0x8004, 0)
    msgbox(format("Hey there, welcome to the Pokémon League's Center! How are you? Would you like to heal your party?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        incrementgamestat(GAME_STAT_USED_POKECENTER)
        msgbox(format("Okay, let me take your Pokémons."))
        hidefollower(0)
        applymovement(2, PkmnCenter_NurseTurn)
        waitmovement(0)
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
        waitfieldeffect(FLDEFF_POKECENTER_HEAL)
        applymovement(2, PkmnCenter_NurseReTurn)
        waitmovement(0)
        special(HealPlayerParty)
        msgbox(format("Here you go, your Pokémons are fully healed!"))
        waitmessage
        applymovement(2, PkmnCenter_NurseBow)
        waitmovement(0)
        msgbox(format("We hope to see you soon!"))
        release
        end
    }
    else {
        msgbox(format("No worries! Come back soon!"))
        release
        end
    }
}

script PkmnLeagueHQ_Lobby_Intendant {
    if (var(VAR_MAIN_STORY) == 8) {
        lock
        faceplayer
        namebox("Bernard")
        msgbox(format("Hello, and welcome to the Pokémon Lea..."))
        closemessage
        hidenamebox
        playse(SE_PIN)
        applymovement(1, moves(emote_exclamation_mark))
        waitmovement(0)
        delay(30)
        namebox("Bernard")
        msgbox(format("{PLAYER}! It's you! I'm so glad to see that you're okay! Please don't sue us. That wasn't our fault."))
        hidenamebox
        msgbox(format("..."))
        namebox("Bernard")
        msgbox(format("Oh? You already knew that? Very well then. On behalf of the Council, we apologise sincerely."))
        hidenamebox
        msgbox(format("..."))
        namebox("Bernard")
        msgbox(format("Uhm, I don't recall collecting any lost items. Xatu also went missing?..."))
        closemessage
        hidenamebox
        delay(20)
        applymovement(1, moves(face_right))
        waitmovement(0)
        delay(20)
        namebox("Bernard")
        msgbox(format("...This is a tragedy..."))
        closemessage
        hidenamebox
        delay(20)
        applymovement(1, moves(face_down))
        waitmovement(0)
        delay(20)
        namebox("Bernard")
        msgbox(format("See, the President has also gone missing, so all of Thura's forces are moving heaven and earth to find him. And because of that, no one is allowed in the premises, from here to the Council HQ. That means that I can't give you back your emblems. Sorry..."))
        hidenamebox
        msgbox(format("...\n..."))
        namebox("Bernard")
        msgbox(format("Again, very sorry for what happened to you and Xatu. Here, let's exchange numbers. If we learn or find anything new, we'll let you know."))
        closemessage
        hidenamebox
        playfanfare(MUS_REGISTER_MATCH_CALL)
        msgbox(format("You registered Employee Bernard."))
        waitfanfare
        closemessage
        delay(40)
        namebox("Bernard")
        msgbox(format("...Uh, I guess that in the meantime, you could take on the Council Challenge all over again? Since you're so talented... We could use some of your skills. Here, take this. With this item, it'll take sooner to raise your new Pokémon."))
        hidenamebox
        giveitem(ITEM_EXP_SHARE)
        delay(20)
        namebox("Bernard")
        msgbox(format("You can also take that device. It's a neat little machine we've been working on, and we called it the DexNav. With this, you can find any Pokémon you want!"))
        closemessage
        hidenamebox
        setflag(FLAG_DEXNAV_GET)
        playfanfare(MUS_RG_OBTAIN_KEY_ITEM)
        msgbox(format("Obtained the DexNav."))
        waitfanfare
        closemessage
        setflag(FLAG_ENABLE_EMPLOYEE_MATCH_CALL)
        setflag(FLAG_HIDE_MAP_NAME_POPUP)
        setvar(VAR_MAIN_STORY, 9)
        release
        end
    }
    elif(var(VAR_MAIN_STORY) > 39) {
        lock
        faceplayer
        namebox("Bernard")
        msgbox(format("{PLAYER}... I'm still shaken about what happened back at the Ironair. Thank you for everything you've done. It's time you face the Council and take over presidential duties... That's what the President would've wanted."))
        hidenamebox
        release
        end
    }
    else {
        lock
        faceplayer
        namebox("Bernard")
        msgbox(format("Hi {PLAYER}! Unfortunately, I don't have any news to share. I'll call you as soon as I got some."))
        hidenamebox
        release
        end
    }
}

script PkmnLeagueHQ_Lobby_Machine {
    lock
    faceplayer
    if(var(VAR_MAIN_STORY) == 36 || var(VAR_MAIN_STORY) == 37 || var(VAR_MAIN_STORY) == 38 || var(VAR_MAIN_STORY) == 39) {
        playse(SE_FAILURE)
        msgbox(format("SORRY, MAINTENANCE IN PROGRESS. ENDING SEQUENCE..."))
        release
        end
    }
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    if(var(VAR_TEMP_1) == 5) {
        msgbox(format("GOOD DAY AND WELCOME TO THURA'S POKEMON LEAGUE. WOULD YOU LIKE TO ENTER?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            msgbox(format("READING ID... CHECKING FOR EMBLEMS..."))
            closemessage
            if(flag(FLAG_BADGE01_GET) && flag(FLAG_BADGE02_GET) &&flag(FLAG_BADGE03_GET) &&flag(FLAG_BADGE04_GET) &&flag(FLAG_BADGE05_GET) &&flag(FLAG_BADGE06_GET) &&flag(FLAG_BADGE07_GET) && flag(FLAG_BADGE08_GET)) {
                delay(40)
                setmetatile(15, 4, METATILE_TrainerHill_GreenFloorTile, FALSE)
                setmetatile(15, 5, METATILE_TrainerHill_GreenFloorTile, FALSE)
                special(DrawWholeMapView)
                playse(MUS_LEVEL_UP)
                msgbox(format("YOU MAY NOW ENTER. GOOD LUCK."))
                closemessage
                release
                end
            }
            else {
                delay(40)
                playse(SE_FAILURE)
                msgbox(format("ERROR. YOU DON'T HAVE THE REQUIRED EMBLEMS TO GO THROUGH. ENDING SEQUENCE..."))
                release
                end
            }
        }
        else {
            msgbox(format("WE HOPE TO SEE YOU SOON AT THURA'S POKEMON LEAGUE."))
            release
            end
        }
    }
    else {
        msgbox(format("HELLO, BRAVE CHALLENGER. WOULD YOU LIKE TO EXIT?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            delay(40)
            setmetatile(15, 4, METATILE_TrainerHill_GreenFloorTile, FALSE)
            setmetatile(15, 5, METATILE_TrainerHill_GreenFloorTile, FALSE)
            special(DrawWholeMapView)
            playse(MUS_LEVEL_UP)
            msgbox(format("YOU MAY NOW EXIT. WE HOPE TO SEE YOU SOON."))
            closemessage
            release
            end
        }
        else {
            msgbox(format("ENDING SEQUENCE..."))
            release
            end
        }
    }
    
}

script PkmnLeagueHQ_HideName {
    if(var(VAR_MAIN_STORY) < 42) {
        setflag(FLAG_HIDE_MAP_NAME_POPUP)
    }
    end
}

script PkmnLeagueHQ_ShowName {
    if(var(VAR_MAIN_STORY) < 42) {
        clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    }
    end
}