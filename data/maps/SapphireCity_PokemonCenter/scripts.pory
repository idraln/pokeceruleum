raw `
SapphireCity_PokemonCenter_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SapphireCity_PokemonCenter_OnTransition
    .byte 0
`

script SapphireCity_PokemonCenter_OnTransition {
    setrespawn(HEAL_LOCATION_SAPPHIRE_CITY)
    end
}


script SapphireCity_PokemonCenter_Nurse {
    lock
	faceplayer
	setvar(VAR_0x8004, 0)
	msgbox(format("Hey there, welcome to Sapphire City's Pokémon Center! How's it going? Would you like to heal your party?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
        incrementgamestat(GAME_STAT_USED_POKECENTER)
        msgbox(format("Okay, let me take your Pokémons."))
        hidefollower(0)
        applymovement(1, PkmnCenter_NurseTurn)
        waitmovement(0)
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
        waitfieldeffect(FLDEFF_POKECENTER_HEAL)
        applymovement(1, PkmnCenter_NurseReTurn)
        waitmovement(0)
        special(HealPlayerParty)
        msgbox(format("Here you go, your Pokémons are fully healed!"))
        waitmessage
        applymovement(1, PkmnCenter_NurseBow)
        waitmovement(0)
        msgbox(format("We hope to see you soon!"))
        release
        end
    }
    else {
        msgbox(format("No worries! Come back soon!"))
        release
        end
    }
}

script SapphireCity_PokemonCenter_Gamer {
    lock
    faceplayer
    msgbox(format("I got this game at the Gaming Center in the supermarket! You should check'em out, real nice people."))
    release
    end
}