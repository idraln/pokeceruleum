raw `
Ohulinn_PokemonCenter_MapScripts::
    map_script MAP_SCRIPT_ON_TRANSITION, Ohulinn_PokemonCenter_OnTransition
	.byte 0
`

script Ohulinn_PokemonCenter_OnTransition {
    setrespawn(HEAL_LOCATION_OHULINN)
    end
}

script Ohulinn_PokemonCenter_Nurse {
    lock
	faceplayer
	setvar(VAR_0x8004, 0)
	msgbox(format("Hey there, welcome to Ohulinn's Pokémon Center! How's it going? Would you like to heal your party?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
        incrementgamestat(GAME_STAT_USED_POKECENTER)
        msgbox(format("Okay, let me take your Pokémons."))
        hidefollower(0)
        applymovement(1, PkmnCenter_NurseTurn)
        waitmovement(0)
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
        waitfieldeffect(FLDEFF_POKECENTER_HEAL)
        applymovement(1, PkmnCenter_NurseReTurn)
        waitmovement(0)
        special(HealPlayerParty)
        msgbox(format("Here you go, your Pokémons are fully healed!"))
        waitmessage
        applymovement(1, PkmnCenter_NurseBow)
        waitmovement(0)
        msgbox(format("We hope to see you soon!"))
        release
        end
    }
    else {
        msgbox(format("No worries! Come back soon!"))
        release
        end
    }
}

script Ohulinn_PokemonCenter_Boy {
    lock
    faceplayer
    msgbox(format("Oof, the wind got me completely exhausted! Walking in here feels like a Mudsdale is holding you back!"))
    release
    end
}

script Ohulinn_PokemonCenter_Woman {
    lock
    faceplayer
    msgbox(format("You should take a dip in the ocean east of here. With the wind, you'll feel rocked by the currents! And get this: it's not even dangerous! No one has ever died because of these currents. Well, not yet at least."))
    release
    end
}