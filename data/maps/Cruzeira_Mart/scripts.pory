raw `
Cruzeira_Mart_MapScripts::
	.byte 0
`

script Cruzeira_Mart_Clerk {
    lock
    faceplayer
    msgbox(format("Hello, and welcome to Cruzeira's mart! How can I help you today?"))
    waitmessage
    waitmessage
    if(var(VAR_SHOP_UPDATE) == 0) {
        pokemart(MartUntil1stBadge)
    }
    elif(var(VAR_SHOP_UPDATE) == 2) {
        pokemart(MartUntil4thBadge)
    }
    elif(var(VAR_SHOP_UPDATE) == 4) {
        pokemart(MartUntil6thBadge)
    }
    else {
        pokemart(MartFinal)
    }
    msgbox(format("Thanks for shopping with us! We hope you come back soon!"))
    release
    end
}

script Cruzeira_Mart_Woman {
    lock
    msgbox(format("Come on, no Energy Roots? I swear I saw them there last time I came..."))
    release
    end
}

mart Cruzeira_Mart_Items {
    ITEM_SUPER_POTION
    ITEM_PARALYZE_HEAL
    ITEM_ANTIDOTE
    ITEM_ENERGY_POWDER
    ITEM_POKE_BALL
    ITEM_REPEL
}