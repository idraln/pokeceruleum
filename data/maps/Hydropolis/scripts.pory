raw `
Hydropolis_MapScripts::
	.byte 0
`

script Hydropolis_AnaisWelcome {
    lock
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    if (var(VAR_TEMP_0) == 14) {
        addobject(11)
        setobjectxy(11, 15, 13)
        turnobject(11, DIR_SOUTH)
        playse(SE_EXIT)
        delay(20)
        applymovement(11, moves(walk_down * 2 walk_left face_down))
        waitmovement(0)
    }
    elif (var(VAR_TEMP_0) == 15) {
        addobject(11)
        setobjectxy(11, 15, 13)
        turnobject(11, DIR_SOUTH)
        playse(SE_EXIT)
        delay(20)
        applymovement(11, moves(walk_down * 2))
        waitmovement(0)
    }
    elif (var(VAR_TEMP_0) == 16) {
        addobject(11)
        setobjectxy(11, 16, 13)
        turnobject(11, DIR_SOUTH)
        playse(SE_EXIT)
        delay(20)
        applymovement(11, moves(walk_down * 2))
        waitmovement(0)
    }
    elif (var(VAR_TEMP_0) == 17) {
        addobject(11)
        setobjectxy(11, 16, 13)
        turnobject(11, DIR_SOUTH)
        playse(SE_EXIT)
        delay(20)
        applymovement(11, moves(walk_down * 2 walk_right face_down))
        waitmovement(0)
    }
    namebox("Anais")
    msgbox(format("Ah, welcome to Hydropolis! You don't look like a researcher, so you must be a challenger!"))
    closemessage
    hidenamebox
    delay(20)
    namebox("Anais")
    msgbox(format("First of all, congratulations! You're almost finished with the Challenge! You must've lived some incredible adventures with your Pokémons! But, it's actually far from over! A last test awaits you. Come meet me in the research room, and you'll know more about it!"))
    closemessage
    hidenamebox
    if (var(VAR_TEMP_0) == 14) {
        delay(20)
        applymovement(11, moves(walk_right walk_up * 2))
        waitmovement(0)
        playse(SE_EXIT)
        setobjectxy(11, 48, 29)
    }
    elif (var(VAR_TEMP_0) == 15) {
        delay(20)
        applymovement(11, moves(walk_up * 2))
        waitmovement(0)
        playse(SE_EXIT)
        setobjectxy(11, 48, 29)
    }
    elif (var(VAR_TEMP_0) == 16) {
        delay(20)
        applymovement(11, moves(walk_up * 2))
        waitmovement(0)
        playse(SE_EXIT)
        setobjectxy(11, 48, 29)
    }
    elif (var(VAR_TEMP_0) == 17) {
        delay(20)
        applymovement(11, moves(walk_left walk_up * 2))
        waitmovement(0)
        playse(SE_EXIT)
        setobjectxy(11, 48, 29)
    }
    setflag(FLAG_DIVERS_NPC)
    clearflag(FLAG_DIVERS_TRAINERS)
    setvar(VAR_MAIN_STORY, 33)
    release
    end
}

script Hydropolis_Diver {
    lock
    faceplayer
    msgbox(format("That's it, this is it! For the first time in my life, I'm going to dive alone. Without any help. Now, if you'll excuse me, I need to gather myself, because I think I'm going to pass out."))
    turnobject(1, DIR_NORTH)
    release
    end
}

script Hydropolis_Worker {
    lock
    faceplayer
    msgbox(format("Remember me? We met near Frux! Yeah, I landed this gig, the pay's good but it gets repetitive quite fast."))
    turnobject(2, DIR_NORTH)
    release
    end
}

script Hydropolis_Scientist1 {
    lock
    faceplayer
    msgbox(format("What? I know there's nothing in my aquariums! I'm getting started, don't rush me!"))
    release
    end
}

script Hydropolis_Intern {
    lock
    faceplayer
    msgbox(format("I'm so happy! An internship in a marine biology lab! My friends are gonna be so jealous when I'll tell them! I'll finally figure out why fish disappeared from Thura's seas!"))
    release
    end
}

script Hydropolis_Scientist2 {
    lock
    msgbox(format("Hmmm... So those corals are actually remnants of Corsola? Did the seawater pH affect the color of its skeleton?..."))
    release
    end
}

script Hydropolis_Nurse {
    lock
    faceplayer
    msgbox(format("Hiya! You must be exhausted after all this time spent underwater. Do you want me to heal your Pokémons?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        msgbox(format("All right! Let me take your Pokémons."))
        closemessage
        fadescreen(FADE_TO_BLACK)
        playfanfare(MUS_HEAL)
        waitfanfare
        special(HealPlayerParty)
        fadescreen(FADE_FROM_BLACK)
        msgbox(format("There you go! Fully healed. See you!"))
    }
    else {
        msgbox(format("Very well then! See you!"))
    }
    release
    end
}

script Hydropolis_Scientist3 {
    lock
    faceplayer
    msgbox(format("We're underwater, and yet we can breathe just fine! You're probably wondering how that's possible, aren't you? Well, we've developed a machine that converts the oxygen in seawater into breathable air! How wonderful!"))
    release
    end
}

script Hydropolis_Scientist4 {
    lock
    faceplayer
    if(var(VAR_MAIN_STORY) > 34 && flag(FLAG_FOSSIL_REVIVED)) {
        msgbox(format("I haven't finished my paper, you've got to let me work!"))
        turnobject(7, DIR_NORTH)
        release
        end
    }
    elif(var(VAR_MAIN_STORY) > 34) {
        msgbox(format("That's it! I've cracked the code! I can finally revive fossils! Haha! Where do you think that Tirtouga came from? Anyways, if you have fossils, I can revive them for you. Free of charge, of course."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            checkitem(ITEM_ROOT_FOSSIL, 1)
            if(var(VAR_RESULT) == TRUE) {
                msgbox(format("Oh yeah! That's one! Give it to me!"))
                closemessage
                removeitem(ITEM_ROOT_FOSSIL, 1)
                fadescreen(FADE_TO_BLACK)
                delay(40)
                playse(MUS_LEVEL_UP)
                waitse
                fadescreen(FADE_FROM_BLACK)
                msgbox(format("And voilà! A fresh Lileep, revived from its thousand-year sleep!"))
                givemon(SPECIES_LILEEP, 10)
                if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
                    playfanfare(MUS_LEVEL_UP)
                    msgbox(format("You just received a Lileep!"))
                    call(NicknamePokemon)
                }
                elif(var(VAR_RESULT) == MON_GIVEN_TO_PC) {
                    playfanfare(MUS_LEVEL_UP)
                    msgbox(format("You just received a Lileep!"))
                    call(NicknameBoxmon)
                }
                msgbox(format("You're welcome. Now go, I've got a paper to write!"))
                setflag(FLAG_FOSSIL_REVIVED)
                turnobject(7, DIR_NORTH)
                completequest(QUEST_FOSSIL)
                release
                end
            }
            else {
                msgbox(format("Hmmm... I don't see any fossils. Come back when you've found one!"))
                turnobject(7, DIR_NORTH)
                release
                end
            }
        }
        else {
            msgbox(format("It's okay! Come back when you've found one!"))
            turnobject(7, DIR_NORTH)
            release
            end   
        }
    }
    else {
        msgbox(format("I'm on the verge of figuring out how to revive fossils! Just give me a few minutes! In the meantime, go talk to Anais!"))
        turnobject(7, DIR_NORTH)
        release
        end
    }  
}

script Hydropolis_Scientist5 {
    lock
    faceplayer
    if(var(VAR_MAIN_STORY) > 42 && var(VAR_DISAPPEARANCE) == 3) {
        msgbox(format("Thanks again, {PLAYER}! The rift is truly a hidden treasure!"))
        release
        end
    }
    elif(var(VAR_MAIN_STORY) > 42 && var(VAR_DISAPPEARANCE) == 2) {
        msgbox(format("So? Have you been inside the rift?"))
        closemessage
        delay(20)
        applymovement(8, moves(emote_exclamation_mark))
        waitmovement(0)
        playse(SE_PIN)
        delay(40)
        msgbox(format("Oh, my! You actually did it!"))
        closemessage
        delay(20)
        msgbox(format("...So, how did it look like?..."))
        closemessage
        delay(20)
        applymovement(8, moves(emote_exclamation_mark))
        waitmovement(0)
        playse(SE_PIN)
        delay(40)
        msgbox(format("No way! A Kyogre, you say? I've only seen it in books!"))
        closemessage
        delay(20)
        msgbox(format("You saw some unknown Pokémon too?! Now that Kyogre left to its home, we need to investigate the rift!"))
        closemessage
        delay(20)
        msgbox(format("Well, you just did Thura a solid. Thanks a lot! You deserve this."))
        giveitem(ITEM_EXP_CANDY_L, 10)
        completequest(QUEST_DISAPPEARANCE)
        setvar(VAR_DISAPPEARANCE, 3)
        release
        end
    }
    elif(var(VAR_MAIN_STORY) > 42 && var(VAR_DISAPPEARANCE) == 1) {
        msgbox(format("So? Have you been inside the rift?"))
        release
        end
    }
    elif(var(VAR_MAIN_STORY) > 42 && var(VAR_DISAPPEARANCE) == 0) {
        msgbox(format("What you're seeing here is probably the last two specimens of Remoraid in Thura! We hoped that they would reproduce, but it turns out they are both females. So we need to clone them, or try to get our hands on a Ditto."))
        closemessage
        delay(20)
        msgbox(format("You look like a well seasoned trainer, am I mistaken?"))
        closemessage
        delay(20)
        applymovement(8, moves(emote_exclamation_mark))
        waitmovement(0)
        playse(SE_PIN)
        delay(40)
        msgbox(format("Oh, my! You're the president! So you're definitely strong."))
        closemessage
        delay(20)
        applymovement(8, moves(face_up))
        waitmovement(0)
        delay(20)
        msgbox(format("Anais must've talked to you about the Mass Extinction of Fish project. It's something that's been a plague in Thura for a few months now."))
        closemessage
        delay(20)
        applymovement(8, moves(face_player))
        waitmovement(0)
        delay(20)
        msgbox(format("We studied this subject for days, we spent many sleepless nights, and we finally cracked the code. The answer to all of our problems lies deep inside the rift down in Mellow Abysses."))
        closemessage
        delay(20)
        applymovement(8, moves(face_up))
        waitmovement(0)
        delay(20)
        msgbox(format("...There's a mighty Pokémon that has made its home there. Well, we actually think that it lost its way to its actual home, and it's making it angrier by the day. And none of the scientists in our team is strong enough to face it. Not even Anais..."))
        closemessage
        delay(20)
        applymovement(8, moves(face_player))
        waitmovement(0)
        delay(20)
        msgbox(format("This is when you come into the picture. We need someone strong enough to help this Pokémon go back to its home. And to achieve that, you'll need to make your way inside the rift. Please!"))
        closemessage
        startquest(QUEST_DISAPPEARANCE)
        setvar(VAR_DISAPPEARANCE, 1)
        release
        end
    }
    else {
        msgbox(format("What you're seeing here is probably the last two specimens of Remoraid in Thura! We hoped that they would reproduce, but it turns out they are both females. So we need to clone them, or try to get our hands on a Ditto."))
        release
        end
    }
}

