    lock
    faceplayer
    msgbox(format("Cooking seafood would be the easy thing to do. But I haven't earned my three stars cooking easy meals!"))
    release
    end
}

script Hydropolis_Anais {
    lock
    faceplayer
    if(var(VAR_MAIN_STORY) == 34) {
        showmonpic(SPECIES_ACCELGOR, 10, 3)
        namebox("Anais")
        msgbox(format("So? Do you want to give it a try? What is the Pokémon we're trying to resurrect? Remember, that's the fossil it's coming from."), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            hidemonpic
            msgbox(format("Ok, let's hear it!"))
            special(EnterHydropolisPokemon)
            waitstate
            special(GetPokemonFeedback)
            //waitstate
            if(var(VAR_RESULT) == 1) {
                closemessage
                delay(40)
                playse(SE_DING_DONG)
                namebox("Anais")
                msgbox(format("Ding ding ding! That's the correct answer! Well done!!"))
                closemessage
                hidenamebox
                delay(20)
                namebox("Anais")
                msgbox(format("You've really earned the last Emblem of the Council Challenge!..."))
                closemessage
                hidenamebox
                delay(20)
                turnobject(11, DIR_NORTH)
                delay(20)
                playbgm(MUS_RG_ENCOUNTER_GYM_LEADER, FALSE)
                namebox("Anais")
                msgbox(format("...Or have you?"))
                closemessage
                hidenamebox
                delay(20)
                faceplayer
                namebox("Anais")
                msgbox(format("There's just one last test you need to pass!"))
                closemessage
                hidenamebox
                trainerbattle_no_intro(TRAINER_ANAIS_HYDRO, Anais1)
                namebox("Anais")
                msgbox(format("Wow! You've done it! You've completed the Council Challenge! Now I can give you your hard-earned Emblem!"))
                closemessage
                hidenamebox
                delay(20)
                playfanfare(MUS_OBTAIN_BADGE)
                msgbox(format("You've earned the Droplet Emblem!"))
                waitfanfare
                setflag(FLAG_BADGE08_GET)
                closemessage
                delay(20)
                namebox("Anais")
                msgbox(format("And for a special trainer like you, a freshly resurrected Tirtouga."))
                closemessage
                hidenamebox
                givemon(SPECIES_TIRTOUGA, 10)
                if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
                    playfanfare(MUS_LEVEL_UP)
                    msgbox(format("You just received a Tirtouga!"))
                    call(NicknamePokemon)
                }
                elif(var(VAR_RESULT) == MON_GIVEN_TO_PC) {
                    playfanfare(MUS_LEVEL_UP)
                    msgbox(format("You just received a Tirtouga!"))
                    call(NicknameBoxmon)
                }
                namebox("Anais")
                msgbox(format("Now go! The hardest part is yet to come. I'm sure you'll succeed with high honors!"))
                hidenamebox
                setvar(VAR_MAIN_STORY, 35)
                if(var(VAR_DIFFICULTY_LEVEL) == 0) {
                    setvar(VAR_LEVELS, 100)
                }
                settrainerflag(TRAINER_ABYSS_1)
                settrainerflag(TRAINER_ABYSS_2)
                settrainerflag(TRAINER_ABYSS_4)
                settrainerflag(TRAINER_ABYSS_5)
                completequest(QUEST_EMBLEMS)
                setflag(FLAG_EMBLEMS_COMPLETE)
            }
            else {
                closemessage
                delay(40)
                playse(SE_RG_HELP_ERROR)
                namebox("Anais")
                msgbox(format("...Nope! Wrong answer! Try again!"))
                hidenamebox
            }
        }
        else {
            hidemonpic
            
            msgbox(format("It's okay, take your time!"))
            hidenamebox
            turnobject(11, DIR_NORTH)
        }
    }
    elif(var(VAR_MAIN_STORY) > 34) {
        namebox("Anais")
        msgbox(format("{PLAYER}, happy to see you! Did you achieve your goal yet?"))
        hidenamebox
    }
    else {
        namebox("Anais")
        msgbox(format("There you are! So, let me explain the rules to you. There are two projects that my team and me are working on right now: the Mass Extinction of Fish, or MEF project, and the Restoration Project. You'll be working on the latter one!"))
        closemessage
        hidenamebox
        delay(20)
        turnobject(11, DIR_NORTH)
        delay(20)
        namebox("Anais")
        msgbox(format("As part of the Restoration project, we're trying to answer current questions by drawing on insights from the past. Right now, we're studying fossils!"))
        closemessage
        hidenamebox
        applymovement(11, moves(face_player))
        waitmovement(0)
        delay(20)
        namebox("Anais")
        msgbox(format("And there's a specific fossil we're studying. Your mission is to figure out which Pokémon this fossil comes from!"))
        closemessage
        hidenamebox
        showmonpic(SPECIES_ACCELGOR, 10, 3)
        delay(120)
        hidemonpic
        applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_question_mark))
        waitmovement(0)
        delay(40)
        namebox("Anais")
        msgbox(format("Don't worry, I scattered some clues in the underwater! You just have to explore. Once you think you got it, come back and tell me your answer! Good luck!"))
        closemessage
        hidenamebox
        turnobject(11, DIR_NORTH)
        setvar(VAR_MAIN_STORY, 34)
        setflag(FLAG_DIVERS_NPC)
        clearflag(FLAG_DIVERS_TRAINERS)
    }
    release
    end
}

text Anais1 {
    format("Congratulations!!")
}

