raw `
GlorrayRetro_PC_MapScripts::
	.byte 0
`

script GlorrayRetro_PC_Nurse {
    lock
	faceplayer
	setvar(VAR_0x8004, 0)
	msgbox(format("Hi {PLAYER}! You finally have your own Pokémon, congratulations! Would you like me to heal your party?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
        incrementgamestat(GAME_STAT_USED_POKECENTER)
        msgbox(format("You got it!"))
        hidefollower(0)
        applymovement(1, PkmnCenter_NurseTurn)
        waitmovement(0)
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
        waitfieldeffect(FLDEFF_POKECENTER_HEAL)
        applymovement(1, PkmnCenter_NurseReTurn)
        waitmovement(0)
        special(HealPlayerParty)
        msgbox(format("Here you go, fully healed!"))
        waitmessage
        applymovement(1, PkmnCenter_NurseBow)
        waitmovement(0)
        msgbox(format("I hope to see you soon! Take care."))
        release
        end
    }
    else {
        msgbox(format("No worries! Hope you come back soon! Take care."))
        release
        end
    }
}

script GlorrayRetro_PC_Kid {
    lock
    faceplayer
    msgbox(format("Isn't that awesome that Pokémon Centers are free to use? At school, I read about a country where going to the hospital can costs thousands of Pokédollars! Haha! How dumb is that?"))
    release
    end
}