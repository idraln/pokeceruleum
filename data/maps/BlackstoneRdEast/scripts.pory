    lockall
    msgbox(format("{UP_ARROW} Glasville\n{DOWN_ARROW} Obsidian Path"))
    releaseall
    end
}

script BlackstoneRdEast_Item {
    lock
    removeobject(10)
    giveitem(ITEM_REAPER_CLOTH)
    setflag(FLAG_ITEM_BLACKSTONE_EAST)
    release
    end
}

script BlackstoneRdEast_TM {
    lock
    removeobject(11)
    giveitem(ITEM_TM17)
    setflag(FLAG_ITEM_BLACKSTONE_EAST_TM)
    release
    end
}

