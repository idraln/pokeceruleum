script Cruzeira_BotanicSchool_Student9 {
    lock
    faceplayer
    if(flag(FLAG_BOT_STUDENTS)) {
        msgbox(format("Huh? Where is everyone? I didn't listen to what the old man said."))
        release
        end
    }
    else {    
        msgbox(format("This is so boring... I wish my parents had enrolled me in a training school, not here."))
        release
        end
    }
}

script Cruzeira_BotanicSchool_Teacher2 {
    lock
    faceplayer
    if(flag(FLAG_BOT_HOMEWORK)) {
        msgbox(format("Aren't plants fascinating?"))
        turnobject(5, DIR_NORTH)
        release
        end
    }
    elif(flag(FLAG_BOT_STUDENTS)) {
        msgbox(format("Hello, {PLAYER}. Have you completed your homework yet?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            msgbox(format("Very well, then. Let's see."))
            checkitem(ITEM_FLOWER_SWEET, 3)
            if(var(VAR_RESULT) == TRUE) {
                msgbox(format("..."))
                msgbox(format("Ah yes! These are the exact species I talked about! Well done, {PLAYER}. Here is a little reward for a job well done."))
                giveitem(ITEM_MIRACLE_SEED)
                msgbox(format("If you give this seed to a Pokémon, it will boost the power of its grass-type moves. Very useful!"))
                completequest(QUEST_ASSIGNMENT)
                setflag(FLAG_BOT_HOMEWORK)
                release
                end
            }
            else {
                msgbox(format("..."))
                msgbox(format("You cheeky one! You haven't completed the homework yet! Come back when you have."))
                release
                end
            }
        }
        else {
            msgbox(format("It's okay, you have plenty of time. Remember, you'll find the daisies I spoke about on Petal Pass, and we recognise them thanks to their vibrant yellow or blue tint."))
            release
            end
        }
    }
    else {
        msgbox(format("What's that? Why aren't you seated, like all the other students?"))
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        multichoice(0, 8, MULTI_BOTANIC, FALSE)
        switch(var(VAR_RESULT)) {
            case 0: 
                msgbox(format("What? Nonsense! Seat down this instant!"))
                closemessage
                if(var(VAR_TEMP_0) == 18) {
                    applymovement(OBJ_EVENT_ID_PLAYER, Botanic18)
                    waitmovement(0)
                    applymovement(5, BotanicTeacher)
                    waitmovement(0)
                    special(SpawnCameraObject)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher)
                    waitmovement(0)
                    delay(10)
                    msgbox(format("Alright class, before I give you your homework, can someone remind me of the various species of daisies?"))
                    closemessage
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamClass)
                    waitmovement(0)
                    msgbox(format("..."))
                    turnobject(8, DIR_EAST)
                    turnobject(7, DIR_WEST)
                    msgbox(format("Uhm... What are they?"))
                    delay(10)
                    turnobject(4, DIR_WEST)
                    turnobject(7, DIR_EAST)
                    msgbox(format("Ah, I swear I know the answer, it's on the tip of my tongue..."))
                    delay(10)
                    closemessage
                    turnobject(8, DIR_NORTH)
                    turnobject(7, DIR_NORTH)
                    turnobject(4, DIR_NORTH)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher2)
                    waitmovement(0)
                    msgbox(format("Haha! This was a trick question. We haven't seen them yet! That's the subject of your next homework."))
                    closemessage
                    applymovement(5, BotanicTeacher2)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicTeacher2)
                    waitmovement(0)
                    msgbox(format("On Petal Pass, just north of this charming town that is Cruzeira, you'll find various species of flowers. Some of which are daisies! Now, you can recognise the species specific to Thura by its colors: the petals are either yellow, or blue. Your mission is to collect 3 daisies, and bring them back here. But, remember! When you pick up the daisies, be gentle. No pulling! Now, go."))
                    closemessage
                    applymovement(7, BotanicStudent6)
                    applymovement(4, BotanicStudent7)
                    applymovement(8, BotanicStudent8)
                    waitmovement(0)
                    removeobject(7)
                    removeobject(4)
                    removeobject(8)
                    setflag(FLAG_BOT_STUDENTS)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamPlayer)
                    waitmovement(0)
                    special(RemoveCameraObject)
                    startquest(QUEST_ASSIGNMENT)
                    release
                    end
                }
                elif(var(VAR_TEMP_0) == 20) {
                    applymovement(OBJ_EVENT_ID_PLAYER, Botanic20)
                    waitmovement(0)
                    applymovement(5, BotanicTeacher)
                    waitmovement(0)
                    special(SpawnCameraObject)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher)
                    waitmovement(0)
                    delay(10)
                    msgbox(format("Alright class, before I give you your homework, can someone remind me of the various species of daisies?"))
                    closemessage
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamClass)
                    waitmovement(0)
                    msgbox(format("..."))
                    turnobject(8, DIR_EAST)
                    turnobject(7, DIR_WEST)
                    msgbox(format("Uhm... What are they?"))
                    delay(10)
                    turnobject(4, DIR_WEST)
                    turnobject(7, DIR_EAST)
                    msgbox(format("Ah, I swear I know the answer, it's on the tip of my tongue..."))
                    delay(10)
                    closemessage
                    turnobject(8, DIR_NORTH)
                    turnobject(7, DIR_NORTH)
                    turnobject(4, DIR_NORTH)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher2)
                    waitmovement(0)
                    msgbox(format("Haha! This was a trick question. We haven't seen them yet! That's the subject of your next homework."))
                    closemessage
                    applymovement(5, BotanicTeacher2)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicTeacher2)
                    waitmovement(0)
                    msgbox(format("On Petal Pass, just north of this charming town that is Cruzeira, you'll find various species of flowers. Some of which are daisies! Now, you can recognise the species specific to Thura by its colors: the petals are either yellow, or blue. Your mission is to collect 3 daisies, and bring them back here. But, remember! When you pick up the daisies, be gentle. No pulling! Now, go."))
                    closemessage
                    applymovement(7, BotanicStudent6)
                    applymovement(4, BotanicStudent7)
                    applymovement(8, BotanicStudent8)
                    waitmovement(0)
                    removeobject(7)
                    removeobject(4)
                    removeobject(8)
                    setflag(FLAG_BOT_STUDENTS)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamPlayer)
                    waitmovement(0)
                    special(RemoveCameraObject)
                    startquest(QUEST_ASSIGNMENT)
                    release
                    end
                }
            case 1:
                msgbox(format("It's okay. Quick, we don't have much time left."))
                closemessage
                if(var(VAR_TEMP_0) == 18) {
                    applymovement(OBJ_EVENT_ID_PLAYER, Botanic18)
                    waitmovement(0)
                    applymovement(5, BotanicTeacher)
                    waitmovement(0)
                    special(SpawnCameraObject)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher)
                    waitmovement(0)
                    delay(10)
                    msgbox(format("Alright class, before I give you your homework, can someone remind me of the various species of daisies?"))
                    closemessage
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamClass)
                    waitmovement(0)
                    msgbox(format("..."))
                    turnobject(8, DIR_EAST)
                    turnobject(7, DIR_WEST)
                    msgbox(format("Uhm... What are they?"))
                    delay(10)
                    turnobject(4, DIR_WEST)
                    turnobject(7, DIR_EAST)
                    msgbox(format("Ah, I swear I know the answer, it's on the tip of my tongue..."))
                    delay(10)
                    closemessage
                    turnobject(8, DIR_NORTH)
                    turnobject(7, DIR_NORTH)
                    turnobject(4, DIR_NORTH)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher2)
                    waitmovement(0)
                    msgbox(format("Haha! This was a trick question. We haven't seen them yet! That's the subject of your next homework."))
                    closemessage
                    applymovement(5, BotanicTeacher2)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicTeacher2)
                    waitmovement(0)
                    msgbox(format("On Petal Pass, just north of this charming town that is Cruzeira, you'll find various species of flowers. Some of which are daisies! Now, you can recognise the species specific to Thura by its colors: the petals are either yellow, or blue. Your mission is to collect 3 daisies, and bring them back here. But, remember! When you pick up the daisies, be gentle. No pulling! Now, go."))
                    closemessage
                    applymovement(7, BotanicStudent6)
                    applymovement(4, BotanicStudent7)
                    applymovement(8, BotanicStudent8)
                    waitmovement(0)
                    removeobject(7)
                    removeobject(4)
                    removeobject(8)
                    setflag(FLAG_BOT_STUDENTS)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamPlayer)
                    waitmovement(0)
                    special(RemoveCameraObject)
                    startquest(QUEST_ASSIGNMENT)
                    release
                    end
                }
                elif(var(VAR_TEMP_0) == 20) {
                    applymovement(OBJ_EVENT_ID_PLAYER, Botanic20)
                    waitmovement(0)
                    applymovement(5, BotanicTeacher)
                    waitmovement(0)
                    special(SpawnCameraObject)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher)
                    waitmovement(0)
                    delay(10)
                    msgbox(format("Alright class, before I give you your homework, can someone remind me of the various species of daisies?"))
                    closemessage
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamClass)
                    waitmovement(0)
                    msgbox(format("..."))
                    turnobject(8, DIR_EAST)
                    turnobject(7, DIR_WEST)
                    msgbox(format("Uhm... What are they?"))
                    delay(10)
                    turnobject(4, DIR_WEST)
                    turnobject(7, DIR_EAST)
                    msgbox(format("Ah, I swear I know the answer, it's on the tip of my tongue..."))
                    delay(10)
                    closemessage
                    turnobject(8, DIR_NORTH)
                    turnobject(7, DIR_NORTH)
                    turnobject(4, DIR_NORTH)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamTeacher2)
                    waitmovement(0)
                    msgbox(format("Haha! This was a trick question. We haven't seen them yet! That's the subject of your next homework."))
                    closemessage
                    applymovement(5, BotanicTeacher2)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicTeacher2)
                    waitmovement(0)
                    msgbox(format("On Petal Pass, just north of this charming town that is Cruzeira, you'll find various species of flowers. Some of which are daisies! Now, you can recognise the species specific to Thura by its colors: the petals are either yellow, or blue. Your mission is to collect 3 daisies, and bring them back here. But, remember! When you pick up the daisies, be gentle. No pulling! Now, go."))
                    closemessage
                    applymovement(7, BotanicStudent6)
                    applymovement(4, BotanicStudent7)
                    applymovement(8, BotanicStudent8)
                    waitmovement(0)
                    removeobject(7)
                    removeobject(4)
                    removeobject(8)
                    setflag(FLAG_BOT_STUDENTS)
                    applymovement(OBJ_EVENT_ID_CAMERA, BotanicCamPlayer)
                    waitmovement(0)
                    special(RemoveCameraObject)
                    startquest(QUEST_ASSIGNMENT)
                    release
                    end
                }
        }
    }
