raw `
Cruzeira_BotanicSchool_MapScripts::
	.byte 0
`

script Cruzeira_BotanicSchool_Teacher1 {
    lock
    faceplayer
    if(flag(FLAG_POKEDEX_COMPLETED)) {
        gettimeofday
        if(var(VAR_0x8000) == 0) {
            msgbox(format("Oh, it's the most amazing trainer of all Thura, {PLAYER}! How are you doing on this fine morning?"))
            release
            end
        }
        elif(var(VAR_0x8000) == 1) {
            msgbox(format("Oh, it's the most amazing trainer of all Thura, {PLAYER}! How are you doing on this fine day?"))
            release
            end
        }
        elif(var(VAR_0x8000) == 2) {
            msgbox(format("Oh, it's the most amazing trainer of all Thura, {PLAYER}! How are you doing on this fine evening?"))
            release
            end
        }
        else {
            msgbox(format("Oh, it's the most amazing trainer of all Thura, {PLAYER}! How are you doing on this fine night?"))
            release
            end
        }
    }
    elif(flag(FLAG_QUEST_POKEDEX)) {
        msgbox(format("Hi, {PLAYER}. Have you completed your Pokédex yet?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            msgbox(format("Let me check, then."))
            closemessage
            playse(SE_POKENAV_ON)
            delay(20)
            specialvar(VAR_RESULT, HasAllHoennMons)
            delay(40)
            if(var(VAR_RESULT) == TRUE) {
                msgbox(format("...Oh, my! How wonderful! You even managed to get info on Diancie, the mythical guardian of the Ironair!"))
                closemessage
                delay(20)
                playse(SE_POKENAV_OFF)
                delay(20)
                msgbox(format("For a job very well done, here is a diploma with your name on it. I'll hang it in the lobby, so that everyone can see how wonderful of a trainer you are."))
                closemessage
                completequest(QUEST_POKEDEX)
                setflag(FLAG_POKEDEX_COMPLETED)
                clearflag(FLAG_QUEST_POKEDEX)
                special(Special_ShowDiploma)
                waitstate
                release
                end
            }
            else {
                playse(SE_POKENAV_OFF)
                delay(20)
                msgbox(format("...Hmm. You're not quite here yet. Try a bit harder!"))
                release
                end
            }
        }
        else {
            msgbox(format("That's fine, {PLAYER}. You're young, you've got a lot of time ahead of you."))
            release
            end
        }
    }
    else {
        msgbox(format("Oh, you have a Pokédex feature on your Phone! That's a rarity, these days. How lucky you are! I'll tell you what: if you manage to complete the whole Pokédex of Thura, come back and see me. I'll have the most beautiful reward for you."))
        startquest(QUEST_POKEDEX)
        setflag(FLAG_QUEST_POKEDEX)
        release
        end
    }
}

script Cruzeira_BotanicSchool_Student1 {
    lock
    msgbox(format("Oh, so angiosperms can also rely on abiotic pollination? Very interesting..."))
    release
    end
}

script Cruzeira_BotanicSchool_Student2 {
    lock
    faceplayer
    msgbox(format("See the boy at the desk to my left? I have a massive crush on him. He seems so passionate about plants... Maybe a bit too much. I wish he could notice me."))
    turnobject(10, DIR_WEST)
    release
    end
}

