script Cruzeira_BotanicSchool_Diploma {
    lock
    if(flag(FLAG_POKEDEX_COMPLETED)) {
        special(Special_ShowDiploma)
        release
        end
    }
    else {
        msgbox(format("This is a blank frame."))
        release
        end
    }
}

movement Botanic18 {
    walk_left
    walk_down * 4
    walk_right * 2
    face_up
}

movement Botanic20 {
    walk_right * 2
    walk_down * 2
    walk_left * 4
    walk_down * 2
    walk_right
    face_up
}

movement BotanicTeacher {
    walk_left * 2
    walk_down * 2
    walk_right * 2
    face_down
}

movement BotanicCamTeacher {
    walk_up * 2
}

movement BotanicCamClass {
    walk_down * 3
}

movement BotanicCamTeacher2 {
    walk_up * 3
}

movement BotanicTeacher2 {
    walk_right * 2
    delay_16
    walk_left * 3
    face_down
}

movement BotanicStudent6 {
    walk_fast_right * 2
    walk_fast_down * 8
}

movement BotanicStudent7 {
    walk_slow_right
    delay_16
    walk_slow_left * 3
    walk_slow_down * 5
}

movement BotanicStudent8 {
    walk_right * 6
    walk_down * 5
}

movement BotanicCamPlayer {
    walk_down * 2
    walk_right
}