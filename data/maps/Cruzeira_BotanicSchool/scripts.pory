}

script Cruzeira_BotanicSchool_Mom {
    lock
    faceplayer
    msgbox(format("Welcome to our botanic school! Feel free to speak to the students and teachers. You'll learn a lot about plants."))
    release
    end
}

script Cruzeira_BotanicSchool_Dad {
    lock
    faceplayer
    msgbox(format("Welcome to Cruzeira's botanic school! Hope you learn a lot in here. We also sell nature mints! Would you be interested in some?"))
    waitmessage
    pokemart(Cruzeira_BotanicSchool_Mart)
    msgbox(format("Thanks! Don't hesitate to come back!"))
    release
    end
}

mart Cruzeira_BotanicSchool_Mart {
    ITEM_LONELY_MINT
    ITEM_ADAMANT_MINT
    ITEM_NAUGHTY_MINT
    ITEM_BRAVE_MINT
    ITEM_BOLD_MINT
    ITEM_IMPISH_MINT
