raw `
Passwacan_Mart_MapScripts::
	.byte 0
`

script Passwacan_Mart_Clerk {
    lock
    faceplayer
    msgbox(format("Hello, and welcome to Passwacan's mart! How can I help you today?"))
    waitmessage
    waitmessage
    if(var(VAR_SHOP_UPDATE) == 0) {
        pokemart(MartUntil1stBadge)
    }
    elif(var(VAR_SHOP_UPDATE) == 2) {
        pokemart(MartUntil4thBadge)
    }
    elif(var(VAR_SHOP_UPDATE) == 4) {
        pokemart(MartUntil6thBadge)
    }
    else {
        pokemart(MartFinal)
    }
    msgbox(format("Thanks for shopping with us! We hope you come back soon!"))
    release
    end
}

script Passwacan_Mart_Customer {
    lock
    faceplayer
    msgbox(format("I never understood the difference between Poké Balls and Ultra Balls. They say Ultra Balls are supposed to be more effective, but I once caught a legendary Pokémon with a Poké Ball. I swear."))
    release
    end
}