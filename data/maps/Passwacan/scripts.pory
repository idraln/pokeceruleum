raw `
Passwacan_MapScripts::
    map_script MAP_SCRIPT_ON_TRANSITION, Passwacan_OnTransition
    map_script MAP_SCRIPT_ON_FRAME_TABLE, Passwacan_OnFrame
	.byte 0

Passwacan_OnFrame:
    map_script_2 VAR_SIDE_STORY_PASSWACAN, 1, Passwacan_UnknownCaller
    map_script_2 VAR_TRIATHLON, 4, Passwacan_TriathlonCeremony
    .2byte 0
`

script Passwacan_OnTransition {
    setflag(FLAG_VISITED_PASSWACAN)
}

script Passwacan_UnknownCaller {
    lockall
    faceplayer
    pokenavcall(PasswacanCall)
    waitmessage
    setvar(VAR_SIDE_STORY_PASSWACAN, 2)
    setvar(VAR_SIDE_STORY_BRO, 1)
    clearflag(FLAG_SAM_KIDNAPPED)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    startquest(QUEST_SAM)
    releaseall
    end
}

script Passwacan_TriathlonCeremony {
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement(0)
    delay(60)
    namebox("Scott")
    msgbox(format("Thank you to everyone who participated! This was truly an amazing display of skills! Now, time for the results."))
    hidenamebox
    closemessage
    applymovement(28, moves(face_left))
    applymovement(14, moves(face_right))
    waitmovement(0)
    delay(40)
    applymovement(28, moves(face_down))
    applymovement(14, moves(face_down))
    waitmovement(0)
    delay(20)
    namebox("Scott")
    msgbox(format("OK, here it comes!"))
    hidenamebox
    closemessage
    if(var(VAR_TRIATHLON_TIME) < 300 && flag(FLAG_TRIATHLON_COMPLETED)) {
        delay(20)
        buffernumberstring(STR_VAR_1, VAR_TRIATHLON_MINUTES)
        buffernumberstring(STR_VAR_2, VAR_TRIATHLON_SECONDS)
        namebox("Scott")
        msgbox(format("And the winner is..."))
        hidenamebox
        closemessage
        delay(20)
        namebox("Scott")
        msgbox(format("With an impressive time of {STR_VAR_1} minutes and {STR_VAR_2} seconds..."))
        hidenamebox
        closemessage
        delay(20)
        applymovement(28, moves(jump_in_place_down))
        waitmovement(0)
        namebox("Scott")
        msgbox(format("{PLAYER}!! Congratulations!!"))
        hidenamebox
        closemessage
        playse(SE_APPLAUSE)
        delay(20)
        namebox("Scott")
        msgbox(format("Please, join me!"))
        hidenamebox
        closemessage
        delay(20)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 2 walk_right face_up))
        waitmovement(0)
        namebox("Scott")
        msgbox(format("And since you already won, a ¥5000 prize money!"))
        hidenamebox
        closemessage
        addmoney(5000)
        delay(20)
        namebox("Scott")
        msgbox(format("Thank you again for participating! Until next time, I hope!"))
        hidenamebox
        closemessage
    } 
    elif(var(VAR_TRIATHLON_TIME) < 300) {
        delay(20)
        buffernumberstring(STR_VAR_1, VAR_TRIATHLON_MINUTES)
        buffernumberstring(STR_VAR_2, VAR_TRIATHLON_SECONDS)
        namebox("Scott")
        msgbox(format("And the winner is..."))
        hidenamebox
        closemessage
        delay(20)
        namebox("Scott")
        msgbox(format("With an impressive time of {STR_VAR_1} minutes and {STR_VAR_2} seconds..."))
        hidenamebox
        closemessage
        delay(20)
        applymovement(28, moves(jump_in_place_down))
        waitmovement(0)
        namebox("Scott")
        msgbox(format("{PLAYER}!! Congratulations!!"))
        hidenamebox
        closemessage
        playse(SE_APPLAUSE)
        delay(20)
        namebox("Scott")
        msgbox(format("Please, join me!"))
        hidenamebox
        closemessage
        delay(20)
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 2 walk_right face_up))
        waitmovement(0)
        namebox("Scott")
        msgbox(format("And for your gift, a brand new bike!"))
        hidenamebox
        closemessage
        giveitem(ITEM_ACRO_BIKE)
        delay(20)
        namebox("Scott")
        msgbox(format("Thank you again for participating! Until next time, I hope!"))
        hidenamebox
        closemessage
        delay(20)
        completequest(QUEST_TRIATHLON)
        setflag(FLAG_TRIATHLON_COMPLETED)
    }
    else {
        delay(20)
        namebox("Scott")
        msgbox(format("And the winner is..."))
        hidenamebox
        closemessage
        delay(20)
        namebox("Scott")
        msgbox(format("With an impressive time of 4 minutes and 59 seconds..."))
        hidenamebox
        closemessage
        delay(20)
        applymovement(28, moves(jump_in_place_down))
        waitmovement(0)
        namebox("Scott")
        msgbox(format("Bettina!! Congratulations!!"))
        hidenamebox
        closemessage
        playse(SE_APPLAUSE)
        delay(20)
        namebox("Scott")
        msgbox(format("Please, join me!"))
        hidenamebox
        closemessage
        delay(20)
        applymovement(17, moves(walk_up * 2))
        waitmovement(0)
        namebox("Scott")
        msgbox(format("And for your gift, a brand new bike!"))
        hidenamebox
        closemessage
        delay(20)
        namebox("Scott")
        msgbox(format("Thank you again for participating! Until next time, I hope!"))
        hidenamebox
        closemessage
    }
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_TRIATHLON_TIME, 0)
    setvar(VAR_TRIATHLON_MINUTES, 0)
    setvar(VAR_TRIATHLON_SECONDS, 0)
    setvar(VAR_TRIATHLON, 0)
    setflag(FLAG_TRIATHLON_CEREMONY)
    setflag(FLAG_TRAINERS_TRIATHLON)
    clearflag(FLAG_PASSWACAN_TRIATHLON_NPC)
    clearflag(FLAG_CANT_FLY)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    cleartrainerflag(TRAINER_TRIATHLON_1)
    cleartrainerflag(TRAINER_TRIATHLON_2)
    cleartrainerflag(TRAINER_TRIATHLON_3)
    cleartrainerflag(TRAINER_TRIATHLON_4)
    cleartrainerflag(TRAINER_ALFIE)
    cleartrainerflag(TRAINER_NELLY)
    cleartrainerflag(TRAINER_ROSE)
    cleartrainerflag(TRAINER_TAKAO)
    cleartrainerflag(TRAINER_FUMIKO)
    delay(20)
    removeobject(22)
    removeobject(28)
    removeobject(23)
    removeobject(24)
    removeobject(18)
    removeobject(19)
    removeobject(15)
    removeobject(21)
    removeobject(20)
    removeobject(17)
    removeobject(16)
    removeobject(25)
    removeobject(26)
    removeobject(27)
    removeobject(13)
    removeobject(14)
    addobject(4)
    addobject(1)
    fadescreen(FADE_FROM_BLACK)
    release
    end
}

script Passwacan_TriathlonEnd {
    lock
    setflag(FLAG_SYS_DISABLE_SAVE)
    clearflag(FLAG_TRIATHLON)
    playse(SE_DING_DONG)
    waitse
    special(StopTriathlonTimer)
    msgbox(format("Congratulations! You've done it!"))
    setvar(VAR_TRIATHLON, 4)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_TRIATHLON_NPC)
    setflag(FLAG_PASSWACAN_TRIATHLON_NPC)
    clearflag(FLAG_TRIATHLON_CEREMONY)
    clearflag(FLAG_SCOTT_TRIATHLON)
    clearflag(FLAG_HIDE_NPC_TRIATHLON)
    addobject(22)
    addobject(28)
    addobject(23)
    addobject(24)
    addobject(18)
    addobject(19)
    addobject(15)
    addobject(21)
    addobject(20)
    addobject(17)
    addobject(16)
    addobject(25)
    addobject(26)
    addobject(27)
    addobject(13)
    addobject(14)
    warpsilent(MAP_PASSWACAN, 16, 38)
    release
    end
}

script Passwacan_OldMan {
    lock
    faceplayer
    msgbox(format("This here is my modest house. You can go in if you want, but please remove your shoes."))
    release
    end
}

script Passwacan_Woman {
    lock
    faceplayer
    msgbox(format("Can you feel it? There's electricity in the air! I'm glad Andre finally decided to turn the waste treatment plant into a power plant. The stench was unbearable."))
    release
    end
}

script Passwacan_WorkerF {
    lock
    faceplayer
    msgbox(format("Andre just put me on welding duty. Only thing is the cables I have to weld are underwater. I'm dead afraid of deep waters."))
    release
    end
}

script Passwacan_WorkerM {
    lock
    faceplayer
    msgbox(format("Watch out, kiddo! Those are ultra powerful generators, you could get shocked and die right away! Back off!"))
    turnobject(2, DIR_NORTH)
    release
    end
}

script Passwacan_Guitarist {
    lock
    faceplayer
    msgbox(format("Do you know about writer's block? I'm experiencing it right now. So I hope this generator right there could give me some energy."))
    turnobject(5, DIR_NORTH)
    release
    end
}

text PasswacanCall {
    "… … … … … …\n… … … … … Beep!\p"
    "Sam: ...{PLAYER}?\p"
    "… … … … … …\p"
    "Something weird has happened\n"
    "to me.\p"
    "… … … … … …\p"
    "Can you come to Oparque?...\n"
    "Don't want to put pressure\l"
    "on you, but if you don't,\l"
    "I might get hurt.\l"
    "Please.\l"
    "… … … … … …\n… … … … … Click!"
}

script Passwacan_Item {
    lock
    removeobject(6)
    giveitem(ITEM_ELECTIRIZER)
    setflag(FLAG_ITEM_PASSWACAN)
    release
    end
}

script Passwacan_Sign {
    lockall
    msgbox(format("Passwacan\nIt smelt bad but not anymore."))
    releaseall
    end
}