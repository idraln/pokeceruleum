                msgbox(format("The path to the Council Member is now open!"))
            }   
        }
        else {
            msgbox(format("Better take some time to think about it."))
        }
    }
    releaseall
    end
}

script Passwacan_Gym_Joris {
    trainerbattle_single(TRAINER_PASSWACAN_GYM_1, Joris1, Joris2)
    msgbox(format("Doesn't the usual 4/4 rhythm feel boring? What do you think?"))
    closemessage
    end
}

text Joris1 {
    format("Feel the power of rock'n roll in your veins!")
}

text Joris2 {
    format("Woah, nice chords bro!")
}

script Passwacan_Gym_Azalea {
    trainerbattle_single(TRAINER_PASSWACAN_GYM_2, Azalea1, Azalea2)
    msgbox(format("We're in a power plant, and somehow the lights are always off. What's the point?"))
    closemessage
    end
}

text Azalea1 {
    format("Aaah! Who are you??")
}

text Azalea2 {
    format("Man, I hate the dark...")
}

script Passwacan_Gym_Zoe {
    trainerbattle_single(TRAINER_PASSWACAN_GYM_3, Zoe1, Zoe2)
    msgbox(format("After 8 years working at Bruce's foundry, I've finally secured a spot in the power plant! Close to the sea!"))
    closemessage
    end
}

text Zoe1 {
    format("This is my first day here! I'm so excited!")
}

text Zoe2 {
    format("Haha, I've been told that the level would be higher here!")
}

script Passwacan_Gym_Boris {
    trainerbattle_single(TRAINER_PASSWACAN_GYM_4, Boris1, Boris2)
    msgbox(format("Some chords are easier to play than some others. I'd rather stick to the classics."))
    closemessage
    end
}

text Boris1 {
    format("Have you ever heard of Green Day?")
}

text Boris2 {
    format("Playing their songs is easier than battling.")
}

script Passwacan_Gym_Andre {
    if(flag(FLAG_BADGE05_GET)) {
        lock
        faceplayer
        namebox("Andre")
        msgbox(format("Oh, another battle, already? I'm afraid I've not fully recovered from the last time, haha!"))
        hidenamebox
        release
        end
    }
    else {
        lock
        faceplayer
        namebox("Andre")
        msgbox(format("Oh, I remember you! You're the kid with the Xatu, right? You're taking the Challenge once again? Hell yeah, I've been dreading revenge! Do you remember this gym? It used to be a waste treatment plant, I turned it into a power plant! Bring it on!"))
        hidenamebox
        closemessage
        trainerbattle_no_intro(TRAINER_ANDRE, Andre1)
        namebox("Andre")
        msgbox(format("...What happened to your Xatu?"))
        hidenamebox
        msgbox(format("..."))
        closemessage
        delay(40)
        namebox("Andre")
        msgbox(format("...Woah. I'm sorry to hear. I hope you guys meet each other very soon."))
        closemessage
        hidenamebox
        delay(40)
        namebox("Andre")
        msgbox(format("Anyway! You know the drill. Take that Emblem."))
        hidenamebox
        setflag(FLAG_BADGE05_GET)
        setvar(VAR_SIDE_STORY_PASSWACAN, 1)
        playfanfare(MUS_OBTAIN_BADGE)
        msgbox(format("You've earned the Sludge Emblem!"))
        waitfanfare
        closemessage
        delay(20)
        namebox("Andre")
        msgbox(format("You also earned the right to this TM! And it's different from last time, what a treat!"))
        hidenamebox
        giveitem(ITEM_TM45)
        namebox("Andre")
        msgbox(format("Please, keep me updated. I really hope you'll find your Xatu soon."))
        hidenamebox
        setflag(FLAG_HIDE_MAP_NAME_POPUP)
        release
        end
    }
}

text Andre1 {
    format("...Huh?")
}