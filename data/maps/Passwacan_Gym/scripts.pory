script Passwacan_Gym_RedSwitch1 {
    lockall
    if(var(VAR_PASSWACAN_RED1) == 2) {
        msgbox(format("The switch has already been activated."))
    }
    else {
        msgbox(format("It's a red switch. Activate it?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            playse(SE_CLICK)
            setmetatile(1, 7, METATILE_Misc1_RedSwitchOpen, TRUE)
            special(DrawWholeMapView)
            delay(30)
            setvar(VAR_PASSWACAN_RED1, 2)
            msgbox(format("Switch activated!"))
            if(var(VAR_PASSWACAN_RED1) == 2 && var(VAR_PASSWACAN_RED2) == 2) {
                setmetatile(9, 15, METATILE_Misc1_FloorLeft, FALSE)
                setmetatile(9, 16, METATILE_Misc1_RedGateTopLeft, FALSE)
                setmetatile(10, 15, METATILE_Misc1_FloorRight, FALSE)
                setmetatile(10, 16, METATILE_Misc1_RedGateTopRight, FALSE)
                special(DrawWholeMapView)
                delay(30)
                animateflash(0)
                setvar(VAR_PASSWACAN_RED, 2)
                playse(MUS_LEVEL_UP)
                msgbox(format("The path to the Council Member is now open!"))
            }   
        }
        else {
            msgbox(format("Better take some time to think about it."))
        }
    }
    releaseall
    end
}

