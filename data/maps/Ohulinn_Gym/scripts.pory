raw `
Ohulinn_Gym_MapScripts::
    map_script MAP_SCRIPT_ON_LOAD, Ohulinn_Gym_OnLoad
	.byte 0
`

script Ohulinn_Gym_OnLoad {
    if(var(VAR_OHULINN_SWITCH_1) == 1 && var(VAR_OHULINN_SWITCH_2) == 1 && var(VAR_OHULINN_SWITCH_3) == 1) {
            setmetatile(9, 3, METATILE_OhulinnGym_StairsTop1, FALSE)
            setmetatile(10, 3, METATILE_OhulinnGym_StairsTop2, FALSE)
            setmetatile(11, 3, METATILE_OhulinnGym_StairsTop3, FALSE)
            setmetatile(9, 4, METATILE_OhulinnGym_StairsBottom1, FALSE)
            setmetatile(10, 4, METATILE_OhulinnGym_StairsBottom2, FALSE)
            setmetatile(11, 4, METATILE_OhulinnGym_StairsBottom3, FALSE)
            special(DrawWholeMapView)
    }
    end
}

script Ohulinn_Gym_Switch1 {
    lock
    msgbox(format("It's a shiny, big red button. Press it?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        closemessage
        delay(30)
        playse(SE_CLICK)
        msgbox(format("Click!... That's the sound it made."))
        closemessage
        setvar(VAR_OHULINN_SWITCH_1, 1)
        if(var(VAR_OHULINN_SWITCH_1) == 1 && var(VAR_OHULINN_SWITCH_2) == 1 && var(VAR_OHULINN_SWITCH_3) == 1) {
            setmetatile(9, 3, METATILE_OhulinnGym_StairsTop1, FALSE)
            setmetatile(10, 3, METATILE_OhulinnGym_StairsTop2, FALSE)
            setmetatile(11, 3, METATILE_OhulinnGym_StairsTop3, FALSE)
            setmetatile(9, 4, METATILE_OhulinnGym_StairsBottom1, FALSE)
            setmetatile(10, 4, METATILE_OhulinnGym_StairsBottom2, FALSE)
            setmetatile(11, 4, METATILE_OhulinnGym_StairsBottom3, FALSE)
            special(DrawWholeMapView)
            delay(30)
            playse(MUS_LEVEL_UP)
            msgbox(format("Stairs just appeared! You can now face the Council member."))
            closemessage
            release
            end
        }
        else {
            release
            end
        }
    }
    else {
        msgbox(format("Better take some time to think about it!"))
        closemessage
        release
        end
    }
}

