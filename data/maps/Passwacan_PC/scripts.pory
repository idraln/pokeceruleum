raw `
Passwacan_PC_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Passwacan_PC_OnTransition
    .byte 0
`

script Passwacan_PC_OnTransition {
    setrespawn(HEAL_LOCATION_PASSWACAN)
    end
}

script Passwacan_PC_Nurse {
    lock
	faceplayer
	setvar(VAR_0x8004, 0)
	msgbox(format("Hi there, welcome to Passwacan's Pokémon Center! Would you like me to heal your party?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
        incrementgamestat(GAME_STAT_USED_POKECENTER)
        msgbox(format("Okay! Give me your Pokémons."))
        hidefollower(0)
        applymovement(1, PkmnCenter_NurseTurn)
        waitmovement(0)
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
        waitfieldeffect(FLDEFF_POKECENTER_HEAL)
        applymovement(1, PkmnCenter_NurseReTurn)
        waitmovement(0)
        special(HealPlayerParty)
        msgbox(format("Here you go, your Pokémons are fully healed!"))
        waitmessage
        applymovement(1, PkmnCenter_NurseBow)
        waitmovement(0)
        msgbox(format("We hope to see you soon!"))
        release
        end
    }
    else {
        msgbox(format("Okay, we hope you come back soon!"))
        release
        end
    }
}

script Passwacan_PC_Kid {
    lock
    faceplayer
    msgbox(format("Look at that Zigzagoon I found on Passaqua Way! Its leg was broken, and the kind nurse got it back on its feet right away!"))
    turnobject(2, DIR_EAST)
    release
    end
}

script Passwacan_PC_Zigzagoon {
    lock
    faceplayer
    playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
    msgbox(format("Zig! Zig!"))
    release
    end
}