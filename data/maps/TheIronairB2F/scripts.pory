raw `
TheIronairB2F_MapScripts::
	.byte 0
`

script TheIronairB2F_TM {
    lock
    removeobject(15)
    setflag(FLAG_ITEM_IRONAIR_B2F)
    giveitem(ITEM_TM37)
    release
    end
}

script TheIronairB2F_Vikkie {
    lock
    msgbox(format("{PLAYER}!!"))
    clearflag(FLAG_VIKKIE_IRONAIR)
    addobject(1)
    closemessage
    delay(20)
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left delay_16 * 2 face_right delay_16 * 2 face_left))
    waitmovement(0)
    delay(20)
    playbgm(MUS_LILYCOVE_MUSEUM, FALSE)
    applymovement(1, moves(walk_down * 5 walk_right * 4 walk_down face_right))
    waitmovement(0)
    delay(20)
    namebox("Vikkie")
    msgbox(format("...{PLAYER}, what are you doing here? Aren't you fighting the Fandango Band? Unless..."))
    closemessage
    hidenamebox
    turnobject(1, DIR_SOUTH)
    delay(20)
    namebox("Vikkie")
    msgbox(format("...You're with them?"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(1, DIR_EAST)
    namebox("Vikkie")
    msgbox(format("...I knew it. I knew that, deep inside, you concealed a dark secret... I just have a sense for these things. I'm afraid I'll have to turn you over to the authorities... Come with me. Struggling won't do you any good."))
    closemessage
    hidenamebox
    applymovement(1, moves(walk_left * 2))
    waitmovement(0)
    fadeoutbgm(1)
    namebox("???")
    msgbox(format("NO!!"))
    closemessage
    hidenamebox
    delay(20)
    applymovement(1, moves(emote_question_mark))
    waitmovement(0)
    delay(40)
    clearflag(FLAG_DAVE_IRONAIR)
    addobject(2)
    applymovement(2, moves(walk_fast_down * 5 walk_fast_right * 4 walk_fast_down face_right))
    waitmovement(0)
    namebox("Dave")
    msgbox(format("{PLAYER}, don't go with her!"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(2, DIR_WEST)
    delay(20)
    namebox("Dave")
    msgbox(format("...She'll hurt you! Like, in a really bad way!"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(2, DIR_EAST)
    delay(20)
    namebox("Dave")
    msgbox(format("...Do you remember about the top secret project I talked you about back in Glorray?"))
    closemessage
    hidenamebox
    delay(20)
    applymovement(2, moves(jump_in_place_left))
    waitmovement(0)
    delay(20)
    namebox("Dave")
    msgbox(format("Turns out it's a real bad project! They want to hurt Pokémons! They want to use the serum I crafted to inject it into a Pokémon! They say this Pokémon, Xatu, will teleport them to the past! I'm pretty sure it doesn't work like that though!"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(2, DIR_EAST)
    delay(20)
    namebox("Dave")
    msgbox(format("They are the ones who provoked the earthquake back at the Pokémon League HQ building! So that Vikkie could become President and Ulrich could get his hands on the sapphires!"))
    closemessage
    hidenamebox
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(40)
    turnobject(2, DIR_SOUTH)
    delay(20)
    namebox("Dave")
    msgbox(format("...Forgive me, {PLAYER}. I'm not a bad guy, I swear! Just a lost scientist!"))
    closemessage
    hidenamebox
    delay(60)
    applymovement(1, moves(walk_right))
    waitmovement(0)
    turnobject(2, DIR_WEST)
    delay(60)
    namebox("Vikkie")
    msgbox(format("...Dave, I knew you were a coward. I shouldn't have recruited you, you've been nothing but a disappointment so far..."))
    closemessage
    hidenamebox
    delay(20)
    turnobject(1, DIR_NORTH)
    delay(20)
    namebox("Vikkie")
    msgbox(format("Persian, get rid of him."))
    closemessage
    hidenamebox
    fadescreen(FADE_TO_WHITE)
    clearflag(FLAG_PERSIAN_IRONAIR)
    addobject(11)
    fadescreen(FADE_FROM_WHITE)
    delay(20)
    playmoncry(SPECIES_PERSIAN, CRY_MODE_NORMAL)
    msgbox(format("Siiiiiiian!"))
    closemessage
    delay(40)
    waitmoncry
    closemessage
    turnobject(2, DIR_NORTH)
    delay(20)
    applymovement(11, moves(jump_down))
    waitmovement(0)
    applymovement(2, moves(jump_down * 4))
    waitmovement(0)
    removeobject(2)
    setflag(FLAG_DAVE_IRONAIR)
    delay(60)
    fadescreen(FADE_TO_WHITE)
    removeobject(11)
    setflag(FLAG_PERSIAN_IRONAIR)
    fadescreen(FADE_FROM_WHITE)
    applymovement(1, moves(walk_right))
    waitmovement(0)
    delay(20)
    goto(TheIronairB2F_VikkiesFight)
}

script TheIronairB2F_VikkiesFight {
    namebox("Vikkie")
    msgbox(format("...Your turn."))
    closemessage
    hidenamebox
    setflag(FLAG_TRAINERBATTLE)
    trainerbattle_no_intro(TRAINER_VIKKIE_IRONAIR, Vikkie2)
    if (var(VAR_TRAINERBATTLE) == B_OUTCOME_LOST) {
        namebox("Vikkie")
        msgbox(format("Hahaha! Pathetic! You're done for!"))
        closemessage
        hidenamebox
        delay(20)
        fadescreen(FADE_TO_BLACK)
        delay(20)
        msgbox(format("Try again?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            closemessage
            special(HealPlayerParty)
            delay(40)
            fadescreen(FADE_FROM_BLACK)
            goto(TheIronairB2F_VikkiesFight)
        }
        else {
            closemessage
            setflag(FLAG_VIKKIE_IRONAIR)
            setflag(FLAG_DAVE_IRONAIR)
            setobjectxyperm(2, 14, 33)
            setobjectxyperm(1, 14, 33)
            special(SetCB2WhiteOut)
            release
            end
        }
    }
    else {
        special(HealPlayerParty)
        delay(20)
        applymovement(1, moves(walk_left))
        waitmovement(0)
        turnobject(1, DIR_EAST)
        delay(20)
        namebox("Vikkie")
        msgbox(format("You'll never catch me! I'm the most powerful woman of Thura! Don't you forget it!"))
        closemessage
        hidenamebox
        applymovement(1, moves(walk_fast_left * 2 walk_fast_up * 2 walk_fast_left walk_fast_up * 4))
        waitmovement(0)
        removeobject(1)
        setflag(FLAG_VIKKIE_IRONAIR)
        delay(60)
        special(SpawnCameraObject)
        namebox("???")
        msgbox(format("{PLAYER}! Down here!"))
        closemessage
        hidenamebox
        applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_diag_southeast * 7 walk_down * 3))
        waitmovement(0)
        applymovement(3, moves(jump_in_place_up))
        waitmovement(0)
        namebox("Ulrich")
        msgbox(format("Look! I've got the President! There's still a chance you can save him! Come down here!"))
        closemessage
        hidenamebox
        delay(20)
        applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 3 walk_diag_northwest * 7))
        waitmovement(0)
        special(RemoveCameraObject)
        setvar(VAR_MAIN_STORY, 38)
        release
        end
    }
}

script TheIronairB2F_Ulrich {
    if(var(VAR_MAIN_STORY) == 39) {
        lock
        namebox("Ulrich")
        msgbox(format("...I don't understand... Why? Why didn't it work? The serum formula was thoroughly followed..."))
        hidenamebox
        release
        end
    }
    else {
        lock
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        namebox("Ulrich")
        msgbox(format("...{PLAYER}, we meet again. And this time, you can see my face."))
        closemessage
        hidenamebox
        delay(40)
        turnobject(3, DIR_SOUTH)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...How long has it been, 10 years? More or less?"))
        closemessage
        hidenamebox
        delay(20)
        applymovement(3, moves(face_player))
        waitmovement(0)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...I never understood why Grandma hated me. She always spoke so fondly about you... And on the other hand, she despised me. When she gave you that egg, I couldn't take it anymore."))
        closemessage
        hidenamebox
        delay(20)
        turnobject(3, DIR_SOUTH)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...So, I left Glorray. I lived in the streets of Sapphire City for a long time. Each time I could, I read. I learned so much. And then, I stumbled on that book..."))
        closemessage
        hidenamebox
        delay(20)
        applymovement(3, moves(face_player))
        waitmovement(0)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...The Legend of Xatu. I knew that Pokémon had psychic powers that are beyond our comprehension... But to learn that it could teleport one into the past? I was sold."))
        closemessage
        hidenamebox
        delay(20)
        turnobject(3, DIR_SOUTH)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...When I learned that you were facing the President, I knew that this was my only chance: I would steal Xatu from you, make it teleport me into the past and finally convince Grandma that I'm worth it. Because in the meantime, I got strong. Very strong."))
        closemessage
        hidenamebox
        delay(20)
        applymovement(3, moves(face_player))
        waitmovement(0)
        delay(20)
        goto(TheIronairB2F_UlrichsFight)
    }
}

script TheIronairB2F_UlrichsFight {
    namebox("Ulrich")
    msgbox(format("...Let me show you."))
    closemessage
    hidenamebox
    setflag(FLAG_TRAINERBATTLE)
    trainerbattle_no_intro(TRAINER_ULRICH_IRONAIR, Ulrich1)
    if (var(VAR_TRAINERBATTLE) == B_OUTCOME_LOST) {
        namebox("Ulrich")
        msgbox(format("...Sorry, {PLAYER}. But your run ends here."))
        closemessage
        hidenamebox
        delay(20)
        fadescreen(FADE_TO_BLACK)
        delay(20)
        msgbox(format("Try again?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            closemessage
            special(HealPlayerParty)
            delay(40)
            fadescreen(FADE_FROM_BLACK)
            goto(TheIronairB2F_UlrichsFight)
        }
        else {
            special(SetCB2WhiteOut)
            release
            end
        }
    }
    else {
        special(HealPlayerParty)
        delay(20)
        turnobject(3, DIR_SOUTH)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...I could've used Xatu, but it wouldn't obey me, no matter what I do. It's okay, though."))
        closemessage
        hidenamebox
        delay(20)
        if(var(VAR_TEMP_0) == 26) {
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right face_up))
            applymovement(3, moves(walk_up))
            waitmovement(0)
        }
        else {
            applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
            applymovement(3, moves(walk_up))
            waitmovement(0)
        }
        delay(20)
        namebox("Ulrich")
        msgbox(format("...It's time you get out of your Pokéball."))
        closemessage
        hidenamebox
        fadescreen(FADE_TO_WHITE)
        special(SpawnCameraObject)
        if(var(VAR_TEMP_0) == 26) {
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 3 walk_left))
            waitmovement(0)
        }
        else {
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 4 walk_right))
            waitmovement(0)
        }
        clearflag(FLAG_XATU_IRONAIR)
        addobject(10)
        fadescreen(FADE_FROM_WHITE)
        delay(40)
        applymovement(3, moves(walk_up * 2))
        waitmovement(0)
        delay(40)
        turnobject(3, DIR_SOUTH)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...Remember your old pal, {PLAYER}? I told you I took care of it."))
        closemessage
        hidenamebox
        delay(20)
        turnobject(3, DIR_NORTH)
        delay(20)
        namebox("Ulrich")
        msgbox(format("...It ends now, though. With that serum, Xatu will be able to teleport me into the past... COME ON, NOW!"))
        closemessage
        hidenamebox
        playse(SE_ORB)
        special(DoOrbEffect)
        call(ScreenShake)
        delay(40)
        call(ScreenShake)
        delay(40)
        call(ScreenShake)
        delay(40)
        special(FadeOutOrbEffect)
        waitstate
        removeobject(10)
        setflag(FLAG_XATU_IRONAIR)
        clearflag(FLAG_XATU_CORRUPTED_IRONAIR)
        addobject(12)
        setweather(WEATHER_VOLCANIC_ASH)
        doweather
        playmoncry(SPECIES_XATU, CRY_MODE_ENCOUNTER)
        delay(40)
        waitmoncry
        delay(40)
        applymovement(3, moves(face_left delay_16 * 3 face_right delay_16 * 3))
        waitmovement(0)
        namebox("Ulrich")
        msgbox(format("...Huh? Why am I still here?"))
        closemessage
        hidenamebox
        delay(20)
        applymovement(3, moves(walk_down jump_in_place_up))
        waitmovement(0)
        namebox("Ulrich")
        msgbox(format("COME ON, YOU STUPID BIRD! TAKE ME BACK TO HER!"))
        closemessage
        hidenamebox
        playmoncry(SPECIES_XATU, CRY_MODE_ENCOUNTER)
        delay(40)
        waitmoncry
        applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_down * 3 walk_fast_right))
        waitmovement(0)
        special(RemoveCameraObject)
        closemessage
        delay(40)
        if(var(VAR_TEMP_0) == 26) {
            applymovement(4, moves(face_up))
            applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
            waitmovement(0)
        }
        else {
            applymovement(4, moves(face_left))
            applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
            waitmovement(0)
        }
        namebox("Pres.")
        msgbox(format("{PLAYER}! Xatu has gone totally rogue, it could cause the Ironair to erupt! You must end its suffering! Go!"))
        closemessage
        hidenamebox
        setvar(VAR_MAIN_STORY, 39)
        release
        end
    }
}

script TheIronairB2F_DontGo {
    lock
    applymovement(4, moves(jump_in_place_up))
    waitmovement(0)
    delay(20)
    namebox("Pres.")
    msgbox(format("{PLAYER}!! Now is not the time to flee! You must deal with Xatu!"))
    closemessage
    hidenamebox
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
    waitmovement(0)
    release
    end
}

script TheIronairB2F_President {
    if(var(VAR_MAIN_STORY) == 39) {
        lock
        faceplayer
        namebox("Pres.")
        msgbox(format("You must stop Xatu now!"))
        hidenamebox
        release
        end
    }
    else {
        lock
        faceplayer
        namebox("Pres.")
        msgbox(format("{PLAYER}! You gotta help me, please!"))
        hidenamebox
        release
        end
    }
}

//setwildbattle SPECIES_GROUDON, 70
