script TheIronairB2F_Xatu {
    lock
    faceplayer
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    setwildbattle(SPECIES_LUGIA, 70)
    waitse
    playmoncry(SPECIES_XATU, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
	waitstate
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    playmoncry(SPECIES_XATU, CRY_MODE_FAINT)
    waitmoncry
    fadescreen(FADE_TO_WHITE)
    delay(60)
    setweather(WEATHER_NONE)
    doweather
    removeobject(12)
    setflag(FLAG_XATU_CORRUPTED_IRONAIR)
    if(var(VAR_TEMP_0) == 27 && var(VAR_TEMP_1) == 45) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down walk_left face_up))
        waitmovement(0)
    }
    elif(var(VAR_TEMP_0) == 26 && var(VAR_TEMP_1) == 44) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left walk_down * 2 walk_right face_up))
        waitmovement(0)
    }
    elif(var(VAR_TEMP_0) == 25 && var(VAR_TEMP_1) == 45) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down walk_right face_up))
        waitmovement(0)
    }
    fadescreen(FADE_FROM_WHITE)
    delay(60)
    applymovement(3, moves(face_down))
    waitmovement(0)
    namebox("Ulrich")
    msgbox(format("...This is it. I've failed, once again..."))
    closemessage
    hidenamebox
    delay(40)
    namebox("???")
    msgbox(format("{PLAYER}!"))
    closemessage
    hidenamebox
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up emote_exclamation_mark))
    applymovement(3, moves(face_up emote_exclamation_mark))
    waitmovement(0)
    delay(40)

    clearflag(FLAG_TEAM_IRONAIR)
    addobject(5)
    addobject(9)
    addobject(13)
    addobject(8)
    applymovement(5, moves(jump_down * 3 walk_fast_down * 3 walk_fast_left * 3))
    applymovement(9, moves(jump_down * 4 walk_fast_down * 3 walk_fast_left * 2))
    applymovement(13, moves(jump_down * 5 walk_fast_down * 3 walk_fast_left * 1))
    applymovement(8, moves(jump_down * 6 walk_fast_down * 3 face_left))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    waitmovement(0)
    delay(60)
    namebox("Bruce")
    msgbox(format("{PLAYER}!! Are you ok?"))
    closemessage
    hidenamebox
    delay(20)
    applymovement(5, moves(face_down))
    waitmovement(0)
    namebox("Bruce")
    msgbox(format("You..."))
    closemessage
    hidenamebox
    delay(40)
    applymovement(5, moves(walk_fast_down face_left))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    namebox("Bruce")
    msgbox(format("You almost wiped out an entire region! For what, your only selfish purpose? YOU'LL PAY FOR YOUR CRIMES!"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(3, DIR_SOUTH)
    delay(20)
    namebox("Ulrich")
    msgbox(format("...No. I don't think I will."))
    closemessage
    hidenamebox
    playse(SE_PIN)
    applymovement(5, moves(emote_exclamation_mark))
    applymovement(13, moves(emote_question_mark))
    applymovement(8, moves(emote_question_mark))
    waitmovement(0)
    delay(40)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down))
    waitmovement(0)
    turnobject(3, DIR_NORTH)
    delay(20)
    //playbgm(MUS_END, TRUE)
    namebox("Ulrich")
    msgbox(format("...{PLAYER}, all I wanted was Grandma to love me like she loved you."))
    closemessage
    hidenamebox
    delay(40)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down walk_right))
    applymovement(3, moves(walk_down walk_right))
    waitmovement(0)
    delay(20)
    turnobject(3, DIR_NORTH)
    delay(20)
    namebox("Ulrich")
    msgbox(format("One last gift to you all..."))
    closemessage
    hidenamebox
    delay(20)
    turnobject(3, DIR_SOUTH)
    delay(20)
    namebox("Ulrich")
    msgbox(format("...You're coming down with me."))
    closemessage
    hidenamebox
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_down))
    applymovement(3, moves(walk_fast_down))
    applymovement(4, moves(jump_down))
    waitmovement(0)
    removeobject(4)
    setflag(FLAG_DEATH)
    playse(SE_PIN)
    applymovement(5, moves(jump_in_place_down emote_exclamation_mark))
    applymovement(9, moves(jump_in_place_down emote_exclamation_mark))
    applymovement(13, moves(jump_in_place_down emote_exclamation_mark))
    applymovement(8, moves(jump_in_place_down emote_exclamation_mark))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down emote_exclamation_mark))
    waitmovement(0)
    delay(40)
    turnobject(3, DIR_NORTH)
    delay(20)
    namebox("Ulrich")
    msgbox(format("...Goodbye, {PLAYER}."))
    closemessage
    hidenamebox
    //fadeoutbgm(1)
    delay(40)
    applymovement(3, moves(jump_down))
    waitmovement(0)
    removeobject(3)
    setflag(FLAG_DEATH_2)
    delay(40)
    applymovement(8, moves(walk_fast_down * 2 walk_fast_left * 3 walk_fast_down jump_in_place_down * 2))
    waitmovement(0)
    namebox("Bernard")
    msgbox(format("PRESIDENT!!!"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(8, DIR_NORTH)
    delay(20)
    namebox("Bernard")
    msgbox(format("We've got to save him!! Quick!!"))
    closemessage
    hidenamebox
    delay(20)
    applymovement(5, moves(walk_in_place_down))
    waitmovement(0)
    delay(20)
    namebox("Bruce")
    msgbox(format("Lad, it's too late. There's nothing we can do. We must gather our forces to find and arrest Vikkie."))
    closemessage
    hidenamebox
    delay(20)
    turnobject(5, DIR_EAST)
    namebox("Bruce")
    msgbox(format("Sam, K.A.M, I need you to form a team and find that woman. She must be stopped at all costs."))
    closemessage
    hidenamebox
    applymovement(13, moves(jump_in_place_left))
    applymovement(9, moves(jump_in_place_left))
    waitmovement(0)
    delay(20)
    msgbox(format("You got it boss!"))
    closemessage
    delay(20)
    applymovement(13, moves(walk_right walk_up * 3 jump_up * 3 walk_fast_up * 2))
    applymovement(9, moves(walk_right * 2 walk_up * 3 jump_up * 3 walk_fast_up * 2))
    waitmovement(0)
    removeobject(9)
    removeobject(13)
    delay(20)
    playmoncry(SPECIES_DIANCIE, CRY_MODE_NORMAL)
    delay(20)
    waitmoncry
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left walk_up * 3))
    playse(SE_PIN)
    applymovement(5, moves(face_up emote_exclamation_mark))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up emote_exclamation_mark))
    waitmovement(0)
    delay(60)
    special(RemoveCameraObject)
    namebox("Bruce")
    msgbox(format("...That cry! It can't be..."))
    closemessage
    hidenamebox
    delay(20)
    clearflag(FLAG_DIANCIE)
    addobject(14)
    applymovement(14, moves(walk_slow_down * 3))
    waitmovement(0)
    delay(40)
    applymovement(5, moves(walk_fast_up * 3 walk_fast_left face_up))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    applymovement(8, moves(face_up))
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_slow_up * 2))
    waitmovement(0)
    namebox("Bruce")
    msgbox(format("DIANCIE! I'M SO SORRY, I FAILED YOU!"))
    closemessage
    hidenamebox
    delay(20)
    playmoncry(SPECIES_DIANCIE, CRY_MODE_NORMAL)
    delay(40)
    waitmoncry
    delay(20)
    namebox("Bruce")
    msgbox(format("You...forgive me? For what I've done to protect the Ironair?"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(5, DIR_SOUTH)
    delay(20)
    turnobject(5, DIR_NORTH)
    namebox("Bruce")
    msgbox(format(" Diancie!!"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(5, DIR_SOUTH)
    delay(20)
    namebox("Bruce")
    msgbox(format("It's {PLAYER} who saved Thura!"))
    closemessage
    hidenamebox
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left walk_up * 2))
    waitmovement(0)
    delay(20)
    turnobject(5, DIR_NORTH)
    namebox("Bruce")
    msgbox(format("They're the one to thank! Not me! I've been nothing but a failure to you!"))
    closemessage
    hidenamebox
    delay(20)
    playmoncry(SPECIES_DIANCIE, CRY_MODE_NORMAL)
    delay(40)
    waitmoncry
    playse(SE_PIN)
    applymovement(5, moves(emote_exclamation_mark))
    waitmovement(0)
    delay(40)
    namebox("Bruce")
    msgbox(format("Thank you, thank you, O mighty guardian of the Ironair! I'll protect your lair with my life!"))
    closemessage
    hidenamebox
    delay(20)
    turnobject(5, DIR_WEST)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    waitmovement(0)
    delay(20)
    namebox("Bruce")
    msgbox(format("Come, {PLAYER}. It's time to go and leave Diancie, now. I'll walk you home."))
    closemessage
    hidenamebox
    turnobject(5, DIR_NORTH)
    delay(40)
    fadescreenspeed(FADE_TO_BLACK, 5)
    special(RemoveCameraObject)
    setvar(VAR_MAIN_STORY, 40)
    clearflag(FLAG_NATU_EGG_LEAGUE)
    warpsilent(MAP_SAPPHIRE_CITY_BUILDING2, 5, 37)
    release
    end
}

