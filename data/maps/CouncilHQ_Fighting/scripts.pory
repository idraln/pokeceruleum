raw `
CouncilHQ_Fighting_MapScripts::
	.byte 0
`

script CouncilHQ_Fighting_Battle {
    lock
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    if(var(VAR_TEMP_1) == 3) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
        waitmovement(0)
    }
    elif(var(VAR_TEMP_1) == 4) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right walk_up face_right))
        waitmovement(0)
    }
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    namebox("Joao")
    msgbox(format("...I'm so glad to see you back again, {PLAYER}. You've truly become a role model for me... Let me show you what I've learned from you."))
    closemessage
    hidenamebox
    delay(20)
    setflag(FLAG_TRAINERBATTLE)
    if(var(VAR_MAIN_STORY) < 56) {
        trainerbattle_no_intro(TRAINER_COUNCIL_FIGHT, Martin2)
    }
    else {
        trainerbattle_no_intro(TRAINER_COUNCIL_FIGHT_2, Martin2)
    }
    if (var(VAR_TRAINERBATTLE) == B_OUTCOME_LOST) {
        namebox("Joao")
        msgbox(format("...I'm sorry, {PLAYER}. You'll have to come back and try again."))
        closemessage
        hidenamebox
        special(HealPlayerParty)
        setvar(VAR_COUNCIL_TRIES, 1)
        setvar(VAR_COUNCIL_FIGHT, 0)
        setvar(VAR_COUNCIL_ICE, 0)
        setvar(VAR_COUNCIL_FIRE, 0)
        setvar(VAR_COUNCIL_ROCK, 0)
        clearflag(FLAG_COUNCIL_ICE)
        clearflag(FLAG_COUNCIL_ROCK)
        clearflag(FLAG_COUNCIL_FIRE)
        clearflag(FLAG_COUNCIL_FIGHT)
        warpsilent(MAP_COUNCIL_HQ_LOBBY, 3, 11)
        releaseall
        end
    }
    else {
        namebox("Joao")
        msgbox(format("Very impressive indeed."))
        hidenamebox
        setvar(VAR_COUNCIL_FIGHT, 1)
        setflag(FLAG_COUNCIL_FIGHT)
        releaseall
        end
    }
}

script CouncilHQ_Fighting_Martin {
    lock
    faceplayer
    namebox("Joao")
    msgbox(format("I need to practice, {PLAYER}. Go and face the others. I'll be worth one day, I promise you."))
    hidenamebox
    release
    end
}

text Martin2 {
    format("...You're even stronger than before... Impressive.")
}